<UserControl x:Class="StatsClient.UserControls.WindowModalBackdropOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent"
             ClipToBounds="True"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <Storyboard x:Key="EntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="Backdrop"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ExitStoryboard"
                    Completed="ExitStoryboard_Completed">
            <DoubleAnimation Storyboard.TargetName="Backdrop"
                             Storyboard.TargetProperty="Opacity"
                             To="0"
                             Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="Backdrop"
            Opacity="0">
        <Border.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.42"
                               Center="0.5,0.42"
                               RadiusX="0.85"
                               RadiusY="0.85">
                <GradientStop Color="#00101828"
                              Offset="0" />
                <GradientStop Color="#CC0B1220"
                              Offset="0.55" />
                <GradientStop Color="#E610172A"
                              Offset="1" />
            </RadialGradientBrush>
        </Border.Background>
    </Border>
</UserControl>
