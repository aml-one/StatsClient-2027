<UserControl x:Class="StatsClient.UserControls.InfinityCometLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="280"
             d:DesignHeight="140"
             Width="280"
             Height="140"
             Background="Transparent"
             ClipToBounds="False"
             IsHitTestVisible="False">
    <Canvas x:Name="OrbitCanvas"
            Width="280"
            Height="140"
            ClipToBounds="False"
            Background="Transparent">
        <Path x:Name="InfinityGuide"
              Stroke="#33FFFFFF"
              StrokeThickness="1.5"
              Fill="Transparent"
              Opacity="0.35"
              IsHitTestVisible="False" />

        <Ellipse x:Name="CometGlow"
                 Width="28"
                 Height="28"
                 Opacity="0.45"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5"
                                     Center="0.5,0.5"
                                     RadiusX="0.5"
                                     RadiusY="0.5">
                    <GradientStop Color="#00FFFFFF"
                                  Offset="0" />
                    <GradientStop Color="#88FDE68A"
                                  Offset="0.55" />
                    <GradientStop Color="#00FDE68A"
                                  Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse x:Name="Trail0"
                 Width="8"
                 Height="8"
                 Fill="#5538BDF8"
                 Opacity="0" />
        <Ellipse x:Name="Trail1"
                 Width="8"
                 Height="8"
                 Fill="#6638BDF8"
                 Opacity="0" />
        <Ellipse x:Name="Trail2"
                 Width="8"
                 Height="8"
                 Fill="#7738BDF8"
                 Opacity="0" />
        <Ellipse x:Name="Trail3"
                 Width="8"
                 Height="8"
                 Fill="#8838BDF8"
                 Opacity="0" />
        <Ellipse x:Name="Trail4"
                 Width="8"
                 Height="8"
                 Fill="#9938BDF8"
                 Opacity="0" />
        <Ellipse x:Name="Trail5"
                 Width="8"
                 Height="8"
                 Fill="#AA38BDF8"
                 Opacity="0" />
        <Ellipse x:Name="Trail6"
                 Width="8"
                 Height="8"
                 Fill="#BB38BDF8"
                 Opacity="0" />
        <Ellipse x:Name="Trail7"
                 Width="8"
                 Height="8"
                 Fill="#CC38BDF8"
                 Opacity="0" />
        <Ellipse x:Name="Trail8"
                 Width="8"
                 Height="8"
                 Fill="#DD38BDF8"
                 Opacity="0" />
        <Ellipse x:Name="Trail9"
                 Width="8"
                 Height="8"
                 Fill="#EE38BDF8"
                 Opacity="0" />

        <Ellipse x:Name="CometHead"
                 Width="12"
                 Height="12"
                 Panel.ZIndex="4"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.35,0.35"
                                     Center="0.35,0.35"
                                     RadiusX="0.65"
                                     RadiusY="0.65">
                    <GradientStop Color="#FFFFFFFF"
                                  Offset="0" />
                    <GradientStop Color="#FFFDE68A"
                                  Offset="0.45" />
                    <GradientStop Color="#FFF59E0B"
                                  Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Canvas>
</UserControl>
