<Window x:Class="StatsClient.MVVM.View.KnowledgeBaseRestoreConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore backup — step 3 of 3"
        Width="420"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Type RESTORE to confirm this destructive action."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ImmersiveTextPrimary}" />
        <TextBox x:Name="ConfirmTextBox"
                 Margin="0,12,0,12"
                 Height="32" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="Restore"
                    Width="90"
                    Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
