<UserControl x:Class="StatsClient.MVVM.View.OrderItemsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="1080">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0 0"
                                     EndPoint="0 1">
                    <LinearGradientBrush.GradientStops>
                        <GradientStop Offset="0.1"
                                      Color="{DynamicResource WhiteBackground_Cl}" />
                        <GradientStop Offset="0.5"
                                      Color="{DynamicResource WhiteBackground_Cl}" />
                        <GradientStop Offset="1"
                                      Color="{DynamicResource SchemeColor_EFEFEF_Cl}" />
                    </LinearGradientBrush.GradientStops>
                </LinearGradientBrush>
            </StackPanel.Background>

            <TextBlock Text="Dental System Version:"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource GlassPanelValueForeground}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding DentalSystemVersion}"
                       d:Text="2018-1"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource NamedDarkGreen}"
                       VerticalAlignment="Center"
                       Margin="3,0,10,0" />

            <TextBlock Text="|"
                       FontSize="10"
                       FontWeight="Normal"
                       Margin="3,0,13,0"
                       Foreground="{DynamicResource NamedSilver}"
                       VerticalAlignment="Center" />

            <TextBlock Text="Design Module Now:"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource GlassPanelValueForeground}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding DesignModuleActual}"
                       d:Text="DD2018"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BlueColor}"
                       VerticalAlignment="Center"
                       Margin="3,0,10,0" />

            <TextBlock Text="|"
                       FontSize="10"
                       FontWeight="Normal"
                       Margin="3,0,13,0"
                       Foreground="{DynamicResource NamedSilver}"
                       VerticalAlignment="Center"
                       Visibility="{Binding DesignModuleOriginal, Converter={StaticResource EmptyToHiddenConverter}}"
                       d:Visibility="Visible" />

            <TextBlock Text="Original Design Module:"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource GlassPanelValueForeground}"
                       VerticalAlignment="Center"
                       Visibility="{Binding DesignModuleOriginal, Converter={StaticResource EmptyToHiddenConverter}}"
                       d:Visibility="Visible" />
            <TextBlock Text="{Binding DesignModuleOriginal}"
                       d:Text="DD2021"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource NamedDarkViolet}"
                       VerticalAlignment="Center"
                       Margin="3,0,10,0"
                       Visibility="{Binding DesignModuleOriginal, Converter={StaticResource EmptyToHiddenConverter}}"
                       d:Visibility="Visible" />

            <TextBlock Text="|"
                       FontSize="10"
                       FontWeight="Normal"
                       Margin="3,0,13,0"
                       Foreground="{DynamicResource NamedSilver}"
                       VerticalAlignment="Center"
                       Visibility="{Binding OriginalOrderID, Converter={StaticResource EmptyToHiddenConverter}}"
                       d:Visibility="Visible" />

            <TextBlock Text="Original Order ID:"
                       FontSize="10"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource GlassPanelValueForeground}"
                       Visibility="{Binding OriginalOrderID, Converter={StaticResource EmptyToHiddenConverter}}"
                       d:Visibility="Visible" />
            <TextBlock Text="{Binding OriginalOrderID}"
                       d:Text="Original Order ID"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SchemeColor_9D6612}"
                       VerticalAlignment="Center"
                       Margin="3,0,10,0" />
        </StackPanel>

        <ListView Style="{StaticResource LvListViewForItemList}"
                  Grid.Row="1"
                  x:Name="listViewItems"
                  ScrollViewer.CanContentScroll="False"
                  BorderThickness="0,1,0,0"
                  BorderBrush="{DynamicResource VitaButtonBorderLight}"
                  Padding="0,10,0,0"
                  AlternationCount="2"
                  ItemsSource="{Binding TDM_ItemsList}"
                  ItemContainerStyle="{StaticResource LvItemForItemList}">
            <ListView.Resources>
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Left" />
                    <Setter Property="IsEnabled"
                            Value="False" />
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn x:Name="headerItem"
                                    Width="350"
                                    DisplayMemberBinding="{Binding Item}" />
                    <GridViewColumn x:Name="headerCacheMaterialName"
                                    Width="720"
                                    DisplayMemberBinding="{Binding CacheMaterialName}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
