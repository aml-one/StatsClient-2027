<Window x:Class="StatsClient.MVVM.View.OrderItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StatsClient.MVVM.View"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Order Items"
        Height="640"
        Width="1120"
        MinHeight="400"
        MinWidth="800"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        FontFamily="Segoe UI"
        Background="{DynamicResource TransparentBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="5"
                            CaptionHeight="0" />
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource ImmersiveGlassBorder}"
            Background="{DynamicResource ClassicWindowBackgroundBrush}"
            ClipToBounds="True">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ImmersiveGlassBackground}"
                    BorderBrush="{DynamicResource ImmersiveGlassBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0"
                    Padding="10,8"
                    Margin="-14,-14,-14,10"
                    PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Order Items"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ImmersiveTextPrimary}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CloseButton"
                               Text="╳"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Cursor="Hand"
                               Foreground="{DynamicResource ImmersiveTextMuted}"
                               ToolTip="Close"
                               PreviewMouseLeftButtonDown="CloseButton_PreviewMouseLeftButtonDown" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource ImmersiveGlassBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="0">
                <local:OrderItemsPanel />
            </Border>

            <Button Grid.Row="2"
                    Content="Close"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    MinWidth="88"
                    MinHeight="34"
                    Padding="14,8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Background="{DynamicResource ImmersiveGlassBackground}"
                    Foreground="{DynamicResource ImmersiveTextPrimary}"
                    BorderBrush="{DynamicResource ImmersiveGlassBorder}"
                    BorderThickness="1"
                    Click="Close_Click" />
        </Grid>
    </Border>
</Window>
