<Window x:Class="StatsClient.MVVM.View.AccountInfoEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New account entry"
        Height="520"
        Width="460"
        MinHeight="480"
        MinWidth="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ImmersiveTextPrimary}">
    <Window.Resources>
        <Style x:Key="FieldLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource ImmersiveTextMuted}" />
            <Setter Property="Margin"
                    Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldTextBox"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Padding"
                    Value="10,6" />
            <Setter Property="Margin"
                    Value="0,0,0,10" />
            <Setter Property="Background"
                    Value="{DynamicResource ImmersiveInputBackground}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource ImmersiveTextPrimary}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ImmersiveInputBorder}" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>
        <Style x:Key="PrimaryActionButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="MinWidth"
                    Value="96" />
            <Setter Property="Padding"
                    Value="14,0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{StaticResource ImmersiveAccentBlue}" />
            <Setter Property="Background"
                    Value="{DynamicResource ImmersiveAccentBlueLight}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ImmersiveAccentBlueBorder}" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>
        <Style x:Key="SecondaryActionButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Foreground"
                    Value="{DynamicResource ImmersiveTextMuted}" />
            <Setter Property="Background"
                    Value="{DynamicResource TransparentBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ImmersiveInputBorder}" />
        </Style>
    </Window.Resources>

    <Border Margin="16"
            Padding="18"
            CornerRadius="10"
            BorderBrush="{DynamicResource ImmersiveGlassBorder}"
            BorderThickness="1"
            Background="{DynamicResource ImmersiveGlassBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Add account entry"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Friendly name *"
                               Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FriendlyNameBox"
                             Style="{StaticResource FieldTextBox}" />

                    <TextBlock Text="Category *"
                               Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CategoryBox"
                             Style="{StaticResource FieldTextBox}" />

                    <TextBlock Text="Sub-category"
                               Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SubCategoryBox"
                             Style="{StaticResource FieldTextBox}" />

                    <TextBlock Text="Website URL"
                               Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="WebsiteBox"
                             Style="{StaticResource FieldTextBox}" />

                    <TextBlock Text="Username *"
                               Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UserNameBox"
                             Style="{StaticResource FieldTextBox}" />

                    <TextBlock Text="Password *"
                               Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordBox"
                                 Height="34"
                                 FontSize="13"
                                 Padding="10,6"
                                 Margin="0,0,0,10"
                                 Background="{DynamicResource ImmersiveInputBackground}"
                                 Foreground="{DynamicResource ImmersiveTextPrimary}"
                                 BorderBrush="{DynamicResource ImmersiveInputBorder}"
                                 BorderThickness="1" />

                    <TextBlock Text="Application name"
                               Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ApplicationNameBox"
                             Style="{StaticResource FieldTextBox}" />

                    <TextBlock Text="Application path"
                               Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ApplicationPathBox"
                             Style="{StaticResource FieldTextBox}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryActionButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="Save"
                        Style="{StaticResource PrimaryActionButton}"
                        IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
