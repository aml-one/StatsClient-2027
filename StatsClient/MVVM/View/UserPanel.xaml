<UserControl x:Class="StatsClient.MVVM.View.UserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StatsClient.MVVM.View"
             xmlns:core="clr-namespace:StatsClient.MVVM.Core"
             xmlns:converter="clr-namespace:StatsClient.MVVM.Converters"
             xmlns:viewmodel="clr-namespace:StatsClient.MVVM.ViewModel"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="900">

    <UserControl.DataContext>
        <viewmodel:UserPanelViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LvItemModern.xaml" />
                <ResourceDictionary Source="/Themes/ScrollBar.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <converter:RemoveFirstCharFromStringIfItsZConverter x:Key="RemoveFirstCharFromStringIfItsZConverter" />
            <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converter:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter" />
            <converter:ZeroToCollapsedVisibilityConverter x:Key="ZeroToCollapsedVisibilityConverter" />

            <Style x:Key="lvHeaderStyle"
                   TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="Background"
                        Value="{DynamicResource NamedWhiteSmoke}" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Left" />
                <Setter Property="BorderThickness"
                        Value="0,0,0,0" />
                <Setter Property="IsHitTestVisible"
                        Value="False" />
                <Setter Property="Margin"
                        Value="-3,0,-3,0" />
            </Style>

            <DataTemplate x:Key="lvHeaderTemplate">
                <DockPanel HorizontalAlignment="Left"
                           LastChildFill="False">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource BlackColor}"
                               FontWeight="Normal"
                               Padding="8,0,0,0"
                               Width="{TemplateBinding Width}"
                               HorizontalAlignment="Left">
                        <TextBlock.Text>
                            <Binding />
                        </TextBlock.Text>
                    </TextBlock>
                </DockPanel>
            </DataTemplate>

            <DataTemplate x:Key="CrownsHeaderTemplate">
                <Image Source="/Images/SentOutCases/crown.png"
                       Width="17"
                       Height="17"
                       Margin="19,0,6,0" />
            </DataTemplate>

            <DataTemplate x:Key="AbutmentsHeaderTemplate">
                <Image Source="/Images/SentOutCases/abutment.png"
                       Width="17"
                       Height="17"
                       Margin="18,0,6,0" />
            </DataTemplate>

            <DataTemplate x:Key="ModelsHeaderTemplate">
                <Image Source="/Images/SentOutCases/i32.png"
                       Width="17"
                       Height="17"
                       Margin="10,0,6,0" />
            </DataTemplate>
           
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="2,0,2,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.Column="1"
                BorderBrush="{DynamicResource SentOutCasesAccordionStripBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,4,0,0"
                Background="{DynamicResource SentOutCasesStatsPanelBackground}">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource SchemeColor_30000000_Cl}"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.12"
                                  Direction="270" />
            </Border.Effect>

            <Grid ClipToBounds="True"
                  Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.RowSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Visibility="{Binding TotalUnitsFinal, Converter={StaticResource ZeroToCollapsedVisibilityConverter}}">
                    <Image Source="/Images/SentOutCases/models.png"
                           Width="38"
                           Height="38"
                           Opacity="0.75"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <core:OutlinedTextBlock Text="{Binding TotalUnitsFinal}"
                                                Stroke="{DynamicResource RxMakerPanelBorder}"
                                                StrokePosition="Outside"
                                                FontSize="34"
                                                FontWeight="SemiBold"
                                                Fill="{DynamicResource SentOutCasesUnitsAccent}"
                                                StrokeThickness="1" />
                        <Label Content="Total Units"
                               Padding="0"
                               Margin="0,-1,0,0"
                               FontSize="9"
                               Foreground="{DynamicResource SentOutCasesUnitsAccent}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Grid.RowSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Visibility="{Binding TotalCrownsFinal, Converter={StaticResource ZeroToCollapsedVisibilityConverter}}">
                    <Image Source="/Images/SentOutCases/crown.png"
                           Width="38"
                           Height="38"
                           Opacity="0.75"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <core:OutlinedTextBlock Text="{Binding TotalCrownsFinal}"
                                                Stroke="{DynamicResource RxMakerPanelBorder}"
                                                StrokePosition="Outside"
                                                FontSize="34"
                                                FontWeight="SemiBold"
                                                Fill="{DynamicResource SentOutCasesCrownsAccent}"
                                                StrokeThickness="1" />
                        <Label Content="Crowns"
                               Padding="0"
                               Margin="0,-1,0,0"
                               FontSize="9"
                               Foreground="{DynamicResource SentOutCasesCrownsAccent}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Grid.RowSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Visibility="{Binding TotalAbutmentsFinal, Converter={StaticResource ZeroToCollapsedVisibilityConverter}}">
                    <Image Source="/Images/SentOutCases/abutment.png"
                           Width="38"
                           Height="38"
                           Opacity="0.75"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <core:OutlinedTextBlock Text="{Binding TotalAbutmentsFinal}"
                                                Stroke="{DynamicResource RxMakerPanelBorder}"
                                                StrokePosition="Outside"
                                                FontSize="34"
                                                FontWeight="SemiBold"
                                                Fill="{DynamicResource SentOutCasesAbutmentsAccent}"
                                                StrokeThickness="1" />
                        <Label Content="Abutments"
                               Padding="0"
                               Margin="0,-1,0,0"
                               FontSize="9"
                               Foreground="{DynamicResource SentOutCasesAbutmentsAccent}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="3"
                            Grid.RowSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Image Source="/Images/SentOutCases/i33.png"
                           Width="38"
                           Height="38"
                           Opacity="0.75"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <core:OutlinedTextBlock Text="{Binding TotalOrdersFinal}"
                                                Stroke="{DynamicResource RxMakerPanelBorder}"
                                                StrokePosition="Outside"
                                                FontSize="34"
                                                FontWeight="SemiBold"
                                                Fill="{DynamicResource SentOutCasesOrdersAccent}"
                                                StrokeThickness="1" />
                        <Label Content="All Cases"
                               Padding="0"
                               Margin="0,-1,0,0"
                               FontSize="9"
                               Foreground="{DynamicResource SentOutCasesOrdersAccent}" />
                    </StackPanel>
                </StackPanel>

                <Label Content="Leftover Units"
                       Grid.Row="0"
                       Grid.Column="5"
                       Margin="0,0,0,0"
                       FontSize="9"
                       Foreground="{DynamicResource SentOutCasesLeftoverAccent}"
                       Visibility="{Binding TotalUnitsTodaySameAsAllTimeTotal}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />

                <Grid Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="5"
                      VerticalAlignment="Center"
                      Visibility="{Binding TotalUnitsTodaySameAsAllTimeTotal}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Grid.Row="0"
                                Margin="0,10,0,2">
                        <Image Source="/Images/SentOutCases/models.png"
                               Width="14"
                               Height="14"
                               Opacity="0.8"
                               Margin="0,0,2,0"
                               VerticalAlignment="Center" />
                        <core:OutlinedTextBlock Text="{Binding TotalUnitsLeftOverFinal}"
                                                Stroke="{DynamicResource RxMakerPanelBorder}"
                                                StrokePosition="Outside"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Fill="{DynamicResource SentOutCasesLeftoverAccent}"
                                                StrokeThickness="1" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Grid.Row="1"
                                Margin="0,0,0,0">
                        <Image Source="/Images/SentOutCases/models.png"
                               Width="14"
                               Height="14"
                               Opacity="0.8"
                               Margin="0,0,2,0"
                               VerticalAlignment="Center" />
                        <core:OutlinedTextBlock Text="{Binding TotalUnitsTodayFinal}"
                                                Stroke="{DynamicResource RxMakerPanelBorder}"
                                                StrokePosition="Outside"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Fill="{DynamicResource SentOutCasesTodayAccent}"
                                                StrokeThickness="1" />
                    </StackPanel>
                </Grid>

                <Label Content="Total Units Today"
                       Grid.Row="1"
                       Grid.Column="5"
                       Margin="0,2,2,0"
                       FontSize="9"
                       Foreground="{DynamicResource SentOutCasesTodayAccent}"
                       Visibility="{Binding TotalUnitsTodaySameAsAllTimeTotal}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom" />

                <Label Content="Leftover Cases"
                       Grid.Row="0"
                       Grid.Column="6"
                       Margin="8,0,0,0"
                       FontSize="9"
                       Foreground="{DynamicResource SentOutCasesLeftoverAccent}"
                       Visibility="{Binding TotalUnitsTodaySameAsAllTimeTotal}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />

                <Grid Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="6"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      Visibility="{Binding TotalUnitsTodaySameAsAllTimeTotal}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Grid.Row="0"
                                Margin="0,10,0,2">
                        <Image Source="/Images/SentOutCases/i33.png"
                               Width="16"
                               Height="16"
                               Opacity="0.8"
                               Margin="0,0,2,0"
                               VerticalAlignment="Center" />
                        <core:OutlinedTextBlock Text="{Binding TotalOrdersLeftOversFinal}"
                                                Stroke="{DynamicResource RxMakerPanelBorder}"
                                                StrokePosition="Outside"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Fill="{DynamicResource SentOutCasesLeftoverAccent}"
                                                StrokeThickness="1" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Grid.Row="1">
                        <Image Source="/Images/SentOutCases/i33.png"
                               Width="16"
                               Height="16"
                               Opacity="0.8"
                               Margin="0,0,2,0"
                               VerticalAlignment="Center" />
                        <core:OutlinedTextBlock Text="{Binding TotalOrdersTodayFinal}"
                                                Stroke="{DynamicResource RxMakerPanelBorder}"
                                                StrokePosition="Outside"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Fill="{DynamicResource SentOutCasesTodayAccent}"
                                                StrokeThickness="1" />
                    </StackPanel>
                </Grid>

                <Label Content="New Cases Today"
                       Grid.Row="1"
                       Grid.Column="6"
                       Margin="8,2,2,0"
                       FontSize="9"
                       Foreground="{DynamicResource SentOutCasesTodayAccent}"
                       Visibility="{Binding TotalOrdersTodaySameAsAllTimeTotal}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom" />

            </Grid>
        </Border>


        <Border Grid.Row="1"
                Margin="0,0,0,0"
                Visibility="Collapsed"
                Background="{DynamicResource SentOutCasesDesignerBarBackground}"
                BorderBrush="{DynamicResource SentOutCasesAccordionStripBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource SchemeColor_30000000_Cl}"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.15"
                                  Direction="270" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="8,4">
                <TextBlock Text="Designer:" 
                           FontWeight="Normal"
                           FontSize="10"
                           Foreground="{DynamicResource RxMakerLabelForeground}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBlock Text="{Binding DesignerName}" 
                           d:Text="Designer Name"
                           Foreground="{DynamicResource SentOutCasesUnitsAccent}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,0,0"
                           FontSize="13"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2"
              Background="{DynamicResource SentOutCasesListAreaBackground}">

            <core:OutlinedTextBlock Text="{Binding DesignerName}"
                                    Grid.Column="3"
                                    Stroke="{DynamicResource VeryLightGrayColor}"
                                    StrokePosition="Outside"
                                    FontSize="60"
                                    FontWeight="SemiBold"
                                    Fill="{DynamicResource SentOutCasesWatermarkForeground}"
                                    Opacity="0.4"
                                    Panel.ZIndex="2"
                                    StrokeThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="3,-10,3,0" />
            <d:Label Grid.Column="3"
                     Content="Designer Name"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SentOutCasesWatermarkForeground}"
                     Opacity="0.4"
                     FontSize="60"
                     Panel.ZIndex="2"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="4,-22,-2,-8" />
        </Grid>

        <ListView ItemsSource="{Binding SentOutCasesModelFinal}"
                  ItemContainerStyle="{StaticResource LvItemSentOutCases}"
                  x:Name="listView"
                  AlternationCount="2"
                  Grid.Row="2"
                  Panel.ZIndex="2"
                  BorderBrush="{DynamicResource EslScrollbarThumb}"
                  Opacity="0.94"
                  SizeChanged="ListViewLeft_SizeChanged">
            <ListView.Resources>
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Left" />
                    <Setter Property="IsEnabled"
                            Value="True" />

                </Style>
            </ListView.Resources>

            <ListView.View>

                <GridView AllowsColumnReorder="False"
                          ColumnHeaderTemplate="{StaticResource lvHeaderTemplate}"
                          ColumnHeaderContainerStyle="{StaticResource lvHeaderStyle}">
                    <GridViewColumn x:Name="headerIcon"
                                    Width="34"
                                    DisplayMemberBinding="{Binding IconImage}" />
                    <GridViewColumn x:Name="headerCaseID"
                                    Width="400"
                                    Header="Case ID"
                                    DisplayMemberBinding="{Binding OrderID}" />
                    <GridViewColumn x:Name="headerCrowns"
                                    Width="45"
                                    HeaderTemplate="{StaticResource CrownsHeaderTemplate}"
                                    DisplayMemberBinding="{Binding Crowns}" />
                    <GridViewColumn x:Name="headerAbutments"
                                    Width="44"
                                    HeaderTemplate="{StaticResource AbutmentsHeaderTemplate}"
                                    DisplayMemberBinding="{Binding Abutments}" />
                    <GridViewColumn x:Name="headerModels"
                                    Width="30"
                                    HeaderTemplate="{StaticResource ModelsHeaderTemplate}"
                                    DisplayMemberBinding="{Binding Models}" />
                    <GridViewColumn x:Name="headerSentOn"
                                    Width="110"
                                    Header="         Sent On"
                                    DisplayMemberBinding="{Binding SentOn}" />

                </GridView>

            </ListView.View>

            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Expander IsExpanded="True"
                                                  Margin="0,0,0,30"
                                                  Loaded="ExpanderLeft_Loaded"
                                                  Collapsed="ExpanderLeft_ExpandedCollapsed"
                                                  Expanded="ExpanderLeft_ExpandedCollapsed">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Name, Converter={StaticResource RemoveFirstCharFromStringIfItsZConverter}}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource NamedGray}"
                                                               FontSize="18"
                                                               VerticalAlignment="Bottom"
                                                               Grid.Column="0" />

                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                Grid.Column="2">

                                                        <TextBlock Text="{Binding ItemCount}"
                                                                   FontSize="16"
                                                                   Foreground="{DynamicResource GreenColor}"
                                                                   FontWeight="Bold"
                                                                   FontStyle="Italic"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Bottom"
                                                                   HorizontalAlignment="Right" />

                                                        <TextBlock Text="cases"
                                                                   FontSize="16"
                                                                   Padding="5,0,0,0"
                                                                   Foreground="{DynamicResource NamedSilver}"
                                                                   FontStyle="Italic"
                                                                   VerticalAlignment="Bottom"
                                                                   HorizontalAlignment="Right" />
                                                    </StackPanel>

                                                </Grid>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <Border Background="{DynamicResource SentOutCasesSearchBackground}"
                Margin="0,0,0,3"
                BorderBrush="{DynamicResource SentOutCasesAccordionStripBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Grid.Row="3">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource SchemeColor_30000000_Cl}"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.15"
                                  Direction="270" />
            </Border.Effect>

            <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>


                <TextBlock Text="SEARCH"
                           Foreground="{DynamicResource RxMakerLabelForeground}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Padding="7,0"
                           VerticalAlignment="Center" />

                <TextBox Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="{DynamicResource TransparentBrush}"
                         Foreground="{DynamicResource RxMakerInputForeground}"
                         Padding="4,0,0,0">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="KeyDown">
                            <i:InvokeCommandAction Command="{Binding FilterCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>

                <TextBlock Text="╳"
                           Grid.Column="2"
                           Foreground="{DynamicResource SentOutCasesLeftoverAccent}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Padding="10,0"
                           Margin="0,-2,0,0"
                           Cursor="Hand"
                           Visibility="{Binding Search, Converter={StaticResource TextToVisibilityConverter}}"
                           VerticalAlignment="Center">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding ClearFilterCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                </TextBlock>
            </Grid>
        </Border>

    </Grid>
</UserControl>
