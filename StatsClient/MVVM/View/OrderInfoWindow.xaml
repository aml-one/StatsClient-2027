<Window x:Class="StatsClient.MVVM.View.OrderInfoWindow"
        x:Name="OrderInfoWindw"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodel="clr-namespace:StatsClient.MVVM.ViewModel"
        xmlns:view="clr-namespace:StatsClient.MVVM.View"
        xmlns:converter="clr-namespace:StatsClient.MVVM.Converters"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:dcm="clr-namespace:DCMViewer.Controls"
        xmlns:usercontrols="clr-namespace:StatsClient.UserControls"
        mc:Ignorable="d"
        Title="OrderInfoWindow"
        Height="850"
        Width="1600"
        MinHeight="750"
        MinWidth="1500"
        MaxHeight="1200"
        MaxWidth="1920"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        WindowState="Normal"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource TransparentBrush}"
        Foreground="{DynamicResource BlackColor}">
    <Window.DataContext>
        <viewmodel:OrderInfoViewModel />
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="0,0,5,5"
                      CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ScrollBar.xaml" />
                <ResourceDictionary Source="/Themes/LvItemModern.xaml" />
                <ResourceDictionary Source="/Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="OrderInfoWatchListEyeToggle"
                   TargetType="CheckBox">
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Width"
                        Value="34" />
                <Setter Property="Height"
                        Value="34" />
                <Setter Property="Background"
                        Value="{DynamicResource TransparentBrush}" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border Background="{DynamicResource TransparentBrush}"
                                    Padding="1">
                                <TextBlock x:Name="EyeIcon"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE7B3;"
                                           FontSize="24"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource OrderInfoWatchListEyeInactive}"
                                           Opacity="0.32" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked"
                                         Value="True">
                                    <Setter TargetName="EyeIcon"
                                            Property="Foreground"
                                            Value="{StaticResource OrderInfoWatchListEyeActive}" />
                                    <Setter TargetName="EyeIcon"
                                            Property="Opacity"
                                            Value="1" />
                                </Trigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="EyeIcon"
                                            Property="Opacity"
                                            Value="0.55" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked"
                                                   Value="True" />
                                        <Condition Property="IsMouseOver"
                                                   Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="EyeIcon"
                                            Property="Opacity"
                                            Value="0.88" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OrderInfoDesignEditToggle"
                   TargetType="ToggleButton">
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Background"
                        Value="{DynamicResource TransparentBrush}" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root"
                                    Background="{DynamicResource TransparentBrush}"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="{StaticResource TransparentBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="{StaticResource TransparentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="{StaticResource TransparentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter TargetName="Root"
                                            Property="Opacity"
                                            Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <converter:EmptyToHiddenConverter x:Key="EmptyToHiddenConverter" />
            <converter:EmptyToCollapsedConverter x:Key="EmptyToCollapsedConverter" />
            <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converter:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter" />
            <converter:StringToImageConverter x:Key="StringToImageConverter" />

            <DataTemplate x:Key="OrderInfoHeaderImageTemplate">
                <Button Background="{DynamicResource TransparentBrush}"
                        BorderThickness="0"
                        Padding="2"
                        Margin="0,0,4,0"
                        Cursor="Hand"
                        Command="{Binding DataContext.ImageClickedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Path}"
                        ToolTip="Open image">
                    <Border Width="60"
                            Height="60"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource GlassPanelBorder}"
                            BorderThickness="1"
                            Background="{DynamicResource GlassPanelBackground}"
                            ClipToBounds="True">
                        <Image Source="{Binding Path, Converter={StaticResource StringToImageConverter}}"
                               Stretch="Uniform"
                               MaxWidth="58"
                               MaxHeight="58"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>


    <Border CornerRadius="8,8,4,8"
            BorderThickness="0.5"
            BorderBrush="{DynamicResource BlackColor}"
            Background="{DynamicResource PrimaryDarkColor}"
            ClipToBounds="True">
        <Border CornerRadius="8,8,8,8"
                BorderThickness="0.5"
                Margin="10"
                BorderBrush="{DynamicResource BlackColor}"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"
                            Value="{DynamicResource PrimaryColor}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsArchiveOrder}"
                                     Value="True">
                            <Setter Property="Background"
                                    Value="{StaticResource ArchiveOrderBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid  Margin="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Panel.ZIndex="50"
                            Margin="0,-6,-7,0">
                    <ToggleButton Style="{StaticResource IosToggleSwitchLqHq}"
                                  IsChecked="{Binding DcmHighQualityRendering, Mode=TwoWay}"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Low quality / High quality rendering" />
                    <Button x:Name="btnToggleFullscreen"
                            Width="32"
                            Height="32"
                            Margin="4,4,14,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TransparentBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Fullscreen"
                            Click="ToggleFullscreen_Click">
                        <TextBlock x:Name="tbFullscreenIcon"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE740;"
                                   FontSize="18"
                                   Foreground="{DynamicResource OrderInfoToolbarValueForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>


                    <Border Background="{DynamicResource DialogCloseButtonBackground}"
                            Width="52"
                            Height="40"
                            Cursor="Hand"
                            CornerRadius="0,9,0,0">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseDown">
                                <i:InvokeCommandAction Command="{Binding CloseWindowCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <TextBlock Text="&#x2573;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource WhiteBackground}"
                                   FontWeight="Bold"
                                   FontSize="16" />
                    </Border>
                </StackPanel>

                <Border BorderBrush="{DynamicResource VitaButtonBorderLight}"
                        BorderThickness="0,0,0,1"
                        Grid.Row="0">
                    <DockPanel>
                        <Ellipse Width="25"
                                 Height="25"
                                 Margin="0,-4,6,0"
                                 Grid.Column="0"
                                 VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding ThreeShapeObject.ImageSource}"
                                            RenderOptions.BitmapScalingMode="Fant" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBox Text="{Binding OrderID}"
                                 FontSize="20"
                                 Margin="0,0,0,0"
                                 BorderThickness="0"
                                 Background="{DynamicResource TransparentBrush}"
                                 Foreground="{DynamicResource BlackColor}"
                                 Cursor="Arrow"
                                 IsReadOnly="True"
                                 FontWeight="Light"
                                 d:Text="OrderID" />


                        <Button Width="25"
                                Height="25"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Margin="20,0,10,4"
                                ToolTip="Rename order"
                                Command="{Binding RenameOrderCommand}"
                                Visibility="{Binding IsArchiveOrder, Converter={StaticResource BoolToInverseVisibilityConverter}}">
                            <Button.Content>
                                <Image Source="/Images/ToolBar/rename.png" />
                            </Button.Content>
                        </Button>



                        <CheckBox Style="{StaticResource OrderInfoWatchListEyeToggle}"
                                  IsChecked="{Binding IsOnWatchList, Mode=TwoWay}"
                                  Margin="6,0,12,4"
                                  VerticalAlignment="Center"
                                  ToolTip="Watch this order"
                                  Visibility="{Binding IsArchiveOrder, Converter={StaticResource BoolToInverseVisibilityConverter}}" />




                        <Grid PreviewMouseDown="TitleBar_PreviewMouseDown"
                              Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text=" " />
                        </Grid>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Margin="0,0,60,25">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="FIRST NAME"
                                       DockPanel.Dock="Left" />
                            <Border CornerRadius="7"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource OrderInfoPtNameColor}"
                                    DockPanel.Dock="Right"
                                    Margin="15,0,0,0"
                                    Width="50"
                                    ClipToBounds="True"
                                    UseLayoutRounding="True">
                                <Button HorizontalAlignment="Center"
                                        Width="50"
                                        Content="SEARCH"
                                        FontSize="9"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource OrderInfoPtNameColor}"
                                        Background="{DynamicResource TransparentBrush}"
                                        Tag="{Binding FirstName}"
                                        Command="{Binding SearchCommand}"
                                        CommandParameter="{Binding FirstName}"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource NamedLightBlue}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border x:Name="Border"
                                                                Background="{TemplateBinding Background}"
                                                                ClipToBounds="True"
                                                                CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource LightGreenColor}"
                                                                        TargetName="Border" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding FirstName}"
                                   d:Text="FIRST NAME"
                                   FontSize="25"
                                   Foreground="{DynamicResource OrderInfoPtNameColor}"
                                   Name="tbFirstName" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="LAST NAME" />
                            <Border CornerRadius="7"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource OrderInfoPtNameColor}"
                                    DockPanel.Dock="Right"
                                    Margin="15,0,0,0"
                                    Width="50"
                                    ClipToBounds="True"
                                    UseLayoutRounding="True">
                                <Button HorizontalAlignment="Center"
                                        Width="50"
                                        Content="SEARCH"
                                        FontSize="9"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource OrderInfoPtNameColor}"
                                        Background="{DynamicResource TransparentBrush}"
                                        Tag="{Binding LastName}"
                                        Command="{Binding SearchCommand}"
                                        CommandParameter="{Binding LastName}"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource NamedLightBlue}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border x:Name="Border"
                                                                Background="{TemplateBinding Background}"
                                                                ClipToBounds="True"
                                                                CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource LightGreenColor}"
                                                                        TargetName="Border" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding LastName}"
                                   d:Text="LAST NAME"
                                   FontSize="25"
                                   Foreground="{DynamicResource OrderInfoPtNameColor}"
                                   Name="tbLastName" />
                    </StackPanel>

                    <DockPanel Grid.Column="2"
                               LastChildFill="True">
                        <StackPanel Width="110"
                                    Margin="20,0"
                                    DockPanel.Dock="Left">
                            <Border BorderBrush="{DynamicResource OrderInfoDividerDark}"
                                    BorderThickness="1"
                                    Margin="10"
                                    Padding="13,5"
                                    CornerRadius="3"
                                    Background="{Binding ThreeShapeObject.PanColor}"
                                    d:Background="{DynamicResource RedColor}"
                                    x:Name="brPanColor"
                                    Cursor="Hand"
                                    Tag="{Binding ThreeShapeObject.PanNumber}"
                                    ToolTip="Search for this pan number..">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDown">
                                        <i:InvokeCommandAction Command="{Binding SearchCommand}"
                                                               CommandParameter="{Binding ThreeShapeObject.PanNumber}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <Border CornerRadius="2"
                                        Background="{DynamicResource WhiteBackground}"
                                        BorderBrush="{DynamicResource VeryLightGrayColor}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding ThreeShapeObject.PanNumber}"
                                               d:Text="8008"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource OrderInfoPanNumberForeground}"
                                               Padding="0,0"
                                               Margin="-2,-3,-2,-1"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               x:Name="tbPanNumber" />
                                </Border>
                            </Border>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    MinWidth="180">
                            <DockPanel LastChildFill="False">
                                <Border CornerRadius="7"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource OrderInfoPtNameColor}"
                                        DockPanel.Dock="Left"
                                        Margin="0,0,15,0"
                                        Width="50"
                                        ClipToBounds="True"
                                        UseLayoutRounding="True">
                                    <Button HorizontalAlignment="Center"
                                            Width="50"
                                            Content="SEARCH"
                                            FontSize="9"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource OrderInfoPtNameColor}"
                                            Background="{DynamicResource TransparentBrush}"
                                            Tag="{Binding Customer}"
                                            Command="{Binding SearchCommand}"
                                            CommandParameter="{Binding Customer}"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource NamedLightBlue}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    ClipToBounds="True"
                                                                    CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource LightGreenColor}"
                                                                            TargetName="Border" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Border>
                                <TextBlock Text="CUSTOMER / DOCTOR"
                                           TextTrimming="CharacterEllipsis"
                                           DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock Text="{Binding Customer}"
                                       d:Text="CUSTOMER / DOCTOR"
                                       FontSize="22"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource OrderInfoPtNameColor}"
                                       HorizontalAlignment="Right"
                                       Name="tbCustomer" />
                        </StackPanel>

                        <ScrollViewer x:Name="orderInfoHeaderImagesPanel"
                                      VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Auto"
                                      Margin="12,0,12,0"
                                      MaxHeight="68"
                                      Visibility="Collapsed"
                                      AllowDrop="True"
                                      Drop="Thumbnails_Drop">
                            <ItemsControl ItemsSource="{Binding ImageList}"
                                          ItemTemplate="{StaticResource OrderInfoHeaderImageTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>


                <!-- Full-bleed 3D canvas; gradient lives on the viewer. Side panels float above. -->
                <Grid Grid.Row="2"
                      Margin="0"
                      AllowDrop="True"
                      Drop="Thumbnails_Drop">
                    <dcm:DcmViewerCanvasComponent x:Name="dcmViewer"
                                                  Background="{DynamicResource TransparentBrush}"
                                                  UseFullAppShell="True"
                                                  IsBackgroundTransparent="True" />

                    <Border x:Name="OrderInfoLeftPanel"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Width="400"
                            Margin="10,8,0,8"
                            Panel.ZIndex="20"
                            Background="{DynamicResource GlassPanelBackground}"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource GlassPanelBorder}"
                            BorderThickness="1">
                        <Grid Margin="12,10,12,10">
                            <ScrollViewer x:Name="orderInfoOverviewScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="{DynamicResource TransparentBrush}">
                                <Grid Background="{DynamicResource TransparentBrush}">
                                    <TextBox Text="RUSH"
                                             FontSize="30"
                                             Margin="0,-7,0,0"
                                             BorderThickness="0"
                                             Background="{DynamicResource TransparentBrush}"
                                             Foreground="{DynamicResource SchemeColor_FFEF4444}"
                                             Cursor="Arrow"
                                             IsReadOnly="True"
                                             FontWeight="Light"
                                             HorizontalAlignment="Right"
                                             Visibility="{Binding IsRush, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel>
                                        <StackPanel Margin="0,1,15,8">
                                            <TextBlock Text="DIGITAL CASE"
                                                       FontSize="10"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelLabelForeground}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DigitalCase}"
                                                       d:Text="DIGITAL CASE"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelValueForeground}"
                                                       Margin="0,0,15,0"
                                                       x:Name="tbDigitalCase" />
                                            <TextBlock Text="TRAY SYSTEM"
                                                       FontSize="10"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelLabelForeground}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding TraySystem, Converter={StaticResource EmptyToHiddenConverter}}" />
                                            <TextBlock Text="{Binding TraySystem}"
                                                       d:Text="TRAY SYSTEM"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelValueForeground}"
                                                       x:Name="tbTraySystem"
                                                       Visibility="{Binding TraySystem, Converter={StaticResource EmptyToHiddenConverter}}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,1,15,12">
                                            <TextBlock Text="SCANNER"
                                                       FontSize="10"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelLabelForeground}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Scanner}"
                                                       d:Text="SCANNER"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelValueForeground}"
                                                       Margin="0,0,15,0"
                                                       x:Name="tbScanner" />
                                        </StackPanel>

                                        <StackPanel Margin="0,1,15,12">
                                            <TextBlock Text="STATUS"
                                                       FontSize="10"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelLabelForeground}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Status}"
                                                       d:Text="STATUS"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelValueForeground}"
                                                       Margin="0,0,15,0"
                                                       x:Name="tbStatus" />
                                        </StackPanel>

                                        <StackPanel Margin="0,1,15,12">
                                            <TextBlock Text="CREATED"
                                                       FontSize="10"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelLabelForeground}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Created}"
                                                       d:Text="CREATED"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelValueForeground}"
                                                       Margin="0,0,15,0"
                                                       x:Name="tbCreated" />
                                        </StackPanel>

                                        <StackPanel Margin="0,1,15,12"
                                                    Visibility="{Binding ShowScanned, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="SCANNED"
                                                       FontSize="10"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelLabelForeground}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Scanned}"
                                                       d:Text="SCANNED"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelValueForeground}"
                                                       Margin="0,0,15,0"
                                                       x:Name="tbScanned" />
                                        </StackPanel>



                                        <StackPanel Margin="0,6,15,10">
                                            <TextBlock Text="MATERIAL"
                                                       FontSize="10"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelLabelForeground}"
                                                       FontWeight="SemiBold"
                                                       x:Name="tbMaterialTitle" />
                                            <TextBlock Text="{Binding Material}"
                                                       d:Text="MATERIAL"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelValueForeground}"
                                                       Margin="0,0,15,0"
                                                       TextWrapping="Wrap"
                                                       x:Name="tbMaterial" />
                                        </StackPanel>

                                        <StackPanel Margin="0,1,15,12">
                                            <TextBlock Text="MANUFACTURER"
                                                       FontSize="10"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelLabelForeground}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Manufacturer}"
                                                       d:Text="MANUFACURER"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelValueForeground}"
                                                       Margin="0,0,15,0"
                                                       TextWrapping="Wrap"
                                                       x:Name="tbManufacturer" />
                                        </StackPanel>



                                        <StackPanel Margin="0,0,15,0"
                                                    Visibility="{Binding Comments, Converter={StaticResource EmptyToHiddenConverter}}">
                                            <TextBlock Text="COMMENTS"
                                                       FontSize="10"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource GlassPanelLabelForeground}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Comments}"
                                                       d:Text="COMMENTS"
                                                       VerticalAlignment="Top"
                                                       Margin="0,0,5,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SchemeColor_006800}"
                                                       TextWrapping="Wrap"
                                                       x:Name="tbComments" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <view:OrderInfoDesignEditStepsPanel x:Name="orderInfoDesignEditStepsPanel"
                                                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Grid HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          Width="200"
                          Margin="0,8,10,8"
                          Panel.ZIndex="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="2" />
                            <RowDefinition MaxHeight="105"
                                           MinHeight="10" />
                        </Grid.RowDefinitions>

                        <view:OrderInfoDesignEditPanel x:Name="orderInfoDesignEditPanel"
                                                       Grid.Row="0"
                                                       Margin="0,0,0,6"
                                                       Visibility="Collapsed" />

                        <Border Grid.Row="1"
                                Background="{DynamicResource GlassPanelBackground}"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource GlassPanelBorder}"
                                BorderThickness="1"
                                Margin="0,0,0,6"
                                x:Name="borderLastTouchedByPanel">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Background="{DynamicResource TransparentBrush}">
                                    <TextBlock Text="LAST TOUCHED BY"
                                               FontSize="11"
                                               Foreground="{DynamicResource GlassPanelSectionTitleForeground}"
                                               HorizontalAlignment="Left"
                                               Margin="14,8,0,0"
                                               FontWeight="SemiBold" />

                                    <StackPanel x:Name="panelLastTouchedBy"
                                                ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                Margin="15,5,15,15">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Stats Server"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource GlassPanelValueForeground}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Saturday - 11/4/2023 4:40:29 AM"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource OrderInfoHintForeground}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Stats Server"
                                                       Foreground="{DynamicResource GlassPanelValueForeground}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Saturday - 11/4/2023 4:40:29 AM"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource OrderInfoHintForeground}" />
                                        </StackPanel>


                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>


                        <Grid Grid.Row="3"
                              Background="{DynamicResource TransparentBrush}">
                            <Grid.ContextMenu>
                                <ContextMenu x:Name="designerContextMenu" />
                            </Grid.ContextMenu>

                            <Border Background="{DynamicResource GlassPanelBackground}"
                                    CornerRadius="4"
                                    BorderBrush="{DynamicResource GlassPanelBorder}"
                                    BorderThickness="1"
                                    x:Name="borderLastDesignedByPanel">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Background="{DynamicResource TransparentBrush}">
                                        <TextBlock Text="DESIGNED BY"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource GlassPanelSectionTitleForeground}"
                                                   HorizontalAlignment="Left"
                                                   FontWeight="SemiBold"
                                                   Margin="14,0,0,0" />

                                        <StackPanel x:Name="panelLastDesignedBy"
                                                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                    Margin="15,5,15,15">
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="Designer Name"
                                                           Foreground="{DynamicResource GlassPanelValueForeground}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Saturday - 11/4/2023 4:40:29 AM"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource OrderInfoHintForeground}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                        </Grid>
                    </Grid>

                    <Grid x:Name="orderInfoLoadingOverlay"
                          Panel.ZIndex="200"
                          IsHitTestVisible="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Setter Property="Opacity"
                                        Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                        <Setter Property="IsHitTestVisible"
                                                Value="True" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0"
                                                                     Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.22"
                                                                                Value="{x:Static Visibility.Collapsed}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsHitTestVisible)">
                                                        <DiscreteBooleanKeyFrame KeyTime="0:0:0.22"
                                                                                 Value="False" />
                                                    </BooleanAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Background="#99000000" />
                        <usercontrols:InfinityCometLoader x:Name="orderInfoCometLoader"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                    </Grid>

                </Grid>

                <Grid VerticalAlignment="Center"
                      Margin="0,6,0,0"
                      Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Grid.Column="0">
                        <Button Width="36"
                                Height="34"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                ToolTip="Open up order source directory"
                                Command="{Binding OpenUpOrderSourceFolderCommand}">
                            <Button.Content>
                                <Image Source="/Images/ToolBar/folder.png" />
                            </Button.Content>
                        </Button>
                        <Button x:Name="addScanButton"
                                Width="44"
                                Height="44"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Margin="0,0,10,-2"
                                ToolTip="Load/Unload scans"
                                Click="AddScanButton_Click">
                            <TextBlock Text="+"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource OrderInfoToolbarAddScanForeground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Width="44"
                                Height="44"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Margin="0,0,10,-2"
                                ToolTip="Reload selected scans"
                                Click="RefreshScansButton_Click">
                            <TextBlock Text="&#x21BB;"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource OrderInfoToolbarRefreshForeground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Button Width="44"
                                Height="44"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                ToolTip="Open XML / stCopy compare"
                                Command="{Binding ShowOrderXmlDiffCommand}">
                            <Button.Content>
                                <Image Source="/Images/ToolBar/xml.png" />
                            </Button.Content>
                        </Button>
                        <!--<Button x:Name="btnToolbarDes"
                                Width="44"
                                Height="44"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                ToolTip="Stats Design"
                                Click="OpenStatsDesign_Click">
                            <TextBlock Text="DES"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource OrderInfoToolbarValueForeground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>-->
                        <Button x:Name="btnToolbarEnc"
                                Width="44"
                                Height="24"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                ToolTip="Identify Encode healing cap"
                                Click="IdentifyEncodeCap_Click">
                            <Button.Content>
                                <Image Source="/Images/ToolBar/encode.png" />
                            </Button.Content>
                        </Button>
                        <ToggleButton x:Name="btnDesignEditToggle"
                                      Style="{StaticResource OrderInfoDesignEditToggle}"
                                      Width="52"
                                      Height="44"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Background="{DynamicResource TransparentBrush}"
                                      BorderThickness="0"
                                      Margin="0,0,10,0"
                                      d:Visibility="Visible"
                                      Click="DesignEditToggle_Click"
                                      Visibility="{Binding CanShowDesignEditButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ToolTip="Edit the 3Shape restoration locally. Changes save to StatsDesignEdit only; DCM files are not modified.">

                            <Image Source="/Images/ToolBar/edit_design.png"
                                   Width="38"
                                   Height="36" />
                        </ToggleButton>

                        <!--<Button x:Name="btnDesignEditToggle"
                                Width="44"
                                Height="24"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                d:Visibility="Visible"
                                Click="DesignEditToggle_Click"
                                Visibility="{Binding CanShowDesignEditButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Edit the 3Shape restoration locally. Changes save to StatsDesignEdit only; DCM files are not modified.">
                            <Button.Content>
                                <Image Source="/Images/ToolBar/edit_design.png" />
                            </Button.Content>
                        </Button>-->

                        <!--<Button Width="44"
                                Height="44"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TransparentBrush}"
                                BorderThickness="0"
                                Margin="0,0,10,0"
                                ToolTip="Show discovered DCM files"
                                Command="{Binding ShowDiscoveredDCMFilesCommand}">
                            <Button.Content>
                                <Image Source="/Images/ToolBar/dcm.png" />
                            </Button.Content>
                        </Button>-->
                        <Border Margin="20,5,15,0"
                                Background="{DynamicResource TransparentBrush}"
                                Cursor="Hand"
                                ToolTip="View order items"
                                PreviewMouseLeftButtonDown="ItemsPanel_PreviewMouseLeftButtonDown">
                            <StackPanel>
                                <TextBlock Text="ITEMS"
                                           FontSize="10"
                                           VerticalAlignment="Top"
                                           Foreground="{DynamicResource OrderInfoToolbarLabelForeground}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Items}"
                                           d:Text="ITEMS"
                                           x:Name="tbItems"
                                           Foreground="{DynamicResource OrderInfoToolbarValueForeground}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <Grid Grid.Column="1"
                          Margin="0,0,5,0"
                          HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              HorizontalAlignment="Right"
                              Visibility="{Binding ThreeShapeObject.ArchiveBaseFolderPath, Converter={StaticResource EmptyToCollapsedConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <Button Width="38"
                                    Height="38"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource TransparentBrush}"
                                    BorderThickness="0"
                                    ToolTip="Generate Zipped Order"
                                    Command="{Binding GenerateArchiveZipCommand}"
                                    Grid.Column="0">
                                <Button.Content>
                                    <Image Source="/Images/ToolBar/download.png"
                                           Width="28"
                                           Height="28" />
                                </Button.Content>
                            </Button>

                            <Button Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource TransparentBrush}"
                                    BorderThickness="0"
                                    ToolTip="Import order"
                                    Grid.Column="1"
                                    Margin="10,0,30,0"
                                    Command="{Binding ImportArchiveOrderCommand}">
                                <Button.Content>
                                    <Image Source="/Images/ToolBar/import.png" />
                                </Button.Content>
                            </Button>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Button Width="52"
                                    Height="24"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,10,0"
                                    Padding="6,2"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="#2BB2C0"
                                    Background="{DynamicResource TransparentBrush}"
                                    BorderBrush="#2BB2C0"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Unlock order"
                                    Command="{Binding UnlockOrderCommand}"
                                    d:Visibility="Visible"
                                    Visibility="{Binding CanUnlockOrder, Converter={StaticResource BoolToVisibilityConverter}}">
                                Unlock
                            </Button>
                            <Button Width="52"
                                    Height="24"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Padding="6,2"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="#C0392B"
                                    Background="{DynamicResource TransparentBrush}"
                                    BorderBrush="#C0392B"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Permanently delete this live 3Shape order (never available for archive orders)"
                                    Command="{Binding DeleteOrderCommand}"
                                    Visibility="{Binding CanDeleteOrder, Converter={StaticResource BoolToVisibilityConverter}}">
                                Delete
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
