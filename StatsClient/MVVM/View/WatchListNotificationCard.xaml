<UserControl x:Class="StatsClient.MVVM.View.WatchListNotificationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:particles="clr-namespace:StatsClient.UserControls"
             Width="360"
             Margin="0,0,0,10"
             Cursor="Hand">
    <UserControl.Resources>
        <Storyboard x:Key="SlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="SlideTransform"
                             Storyboard.TargetProperty="X"
                             From="420"
                             To="0"
                             Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.35" />
        </Storyboard>
        <Storyboard x:Key="DismissStoryboard">
            <DoubleAnimation Storyboard.TargetName="SlideTransform"
                             Storyboard.TargetProperty="X"
                             To="420"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="0"
                             Duration="0:0:0.28" />
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="420" />
        </Border.RenderTransform>
        <Border CornerRadius="10"
                BorderThickness="1"
                Padding="0"
                MinHeight="92"
                Background="#E638485A">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#AA38BDF8" Offset="0" />
                    <GradientStop Color="#4467E8F9" Offset="0.45" />
                    <GradientStop Color="#AA38BDF8" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#0038BDF8"
                                  BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.65" />
            </Border.Effect>

            <Grid>
                <particles:HolographicParticlesOverlay IsHitTestVisible="False"
                                                       Opacity="0.55" />
                <Rectangle HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           RadiusX="10"
                           RadiusY="10"
                           IsHitTestVisible="False"
                           Opacity="0.18">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#5538BDF8" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.55" />
                            <GradientStop Color="#4467E8F9" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle x:Name="AccentBar"
                           Width="4"
                           HorizontalAlignment="Left"
                           RadiusX="2"
                           RadiusY="2"
                           Margin="0,10,0,10" />

                <Grid Margin="14,12,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               LastChildFill="True">
                        <TextBlock x:Name="AgeText"
                                   DockPanel.Dock="Right"
                                   Text="00:00"
                                   Foreground="#7DD3FC"
                                   FontSize="10"
                                   FontFamily="pack://application:,,,/Fonts/#RobotoMono"
                                   VerticalAlignment="Top"
                                   Margin="0,2,8,0"
                                   Opacity="0.9" />
                        <Border DockPanel.Dock="Right"
                                Width="18"
                                Height="18"
                                CornerRadius="9"
                                Background="#33000000"
                                VerticalAlignment="Top">
                            <TextBlock Text="×"
                                       Foreground="#CCF8FAFC"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0" />
                        </Border>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,8,0">
                            <Ellipse Width="10"
                                     Height="10"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="PulseBrush" Color="#38BDF8" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="TitleText"
                                       Text="Status update"
                                       Foreground="#F8FAFC"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock x:Name="OrderIdText"
                               Grid.Row="1"
                               Margin="18,4,0,0"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontFamily="pack://application:,,,/Fonts/#RobotoMono" />

                    <TextBlock x:Name="MessageText"
                               Grid.Row="2"
                               Margin="18,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="#E2E8F0"
                               FontSize="12.5"
                               LineHeight="18" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
