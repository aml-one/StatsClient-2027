<Window x:Class="StatsClient.MVVM.View.UsefulWebsiteEntryWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"

        Title="Useful website"

        Height="400"

        Width="480"

        MinHeight="380"

        MinWidth="420"

        ResizeMode="NoResize"

        WindowStartupLocation="CenterOwner"

        ShowInTaskbar="False"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="{DynamicResource TransparentBrush}"

        Foreground="{DynamicResource ImmersiveTextPrimary}">

    <WindowChrome.WindowChrome>

        <shell:WindowChrome CaptionHeight="0"

                            ResizeBorderThickness="0"

                            CornerRadius="0"

                            GlassFrameThickness="0" />

    </WindowChrome.WindowChrome>



    <Window.Resources>

        <Style x:Key="FieldLabel"

               TargetType="TextBlock">

            <Setter Property="FontSize"

                    Value="12" />

            <Setter Property="FontWeight"

                    Value="SemiBold" />

            <Setter Property="Foreground"

                    Value="{DynamicResource ImmersiveTextMuted}" />

            <Setter Property="Margin"

                    Value="0,0,0,4" />

        </Style>

        <Style x:Key="FieldTextBox"

               TargetType="TextBox">

            <Setter Property="Height"

                    Value="34" />

            <Setter Property="FontSize"

                    Value="13" />

            <Setter Property="Padding"

                    Value="10,6" />

            <Setter Property="Margin"

                    Value="0,0,0,10" />

            <Setter Property="Background"

                    Value="{DynamicResource ImmersiveInputBackground}" />

            <Setter Property="Foreground"

                    Value="{DynamicResource ImmersiveTextPrimary}" />

            <Setter Property="BorderBrush"

                    Value="{DynamicResource ImmersiveInputBorder}" />

            <Setter Property="BorderThickness"

                    Value="1" />

        </Style>

        <Style x:Key="PrimaryActionButton"

               TargetType="Button">

            <Setter Property="Height"

                    Value="34" />

            <Setter Property="MinWidth"

                    Value="96" />

            <Setter Property="Padding"

                    Value="14,0" />

            <Setter Property="Cursor"

                    Value="Hand" />

            <Setter Property="FontWeight"

                    Value="SemiBold" />

            <Setter Property="Foreground"

                    Value="{StaticResource ImmersiveAccentBlue}" />

            <Setter Property="Background"

                    Value="{DynamicResource ImmersiveAccentBlueLight}" />

            <Setter Property="BorderBrush"

                    Value="{DynamicResource ImmersiveAccentBlueBorder}" />

            <Setter Property="BorderThickness"

                    Value="1" />

        </Style>

        <Style x:Key="SecondaryActionButton"

               TargetType="Button"

               BasedOn="{StaticResource PrimaryActionButton}">

            <Setter Property="Foreground"

                    Value="{DynamicResource ImmersiveTextMuted}" />

            <Setter Property="Background"

                    Value="{DynamicResource TransparentBrush}" />

            <Setter Property="BorderBrush"

                    Value="{DynamicResource ImmersiveInputBorder}" />

        </Style>

        <Style x:Key="TitleBarCloseButton"

               TargetType="Button">

            <Setter Property="Width"

                    Value="28" />

            <Setter Property="Height"

                    Value="28" />

            <Setter Property="Padding"

                    Value="0" />

            <Setter Property="Margin"

                    Value="0" />

            <Setter Property="Cursor"

                    Value="Hand" />

            <Setter Property="FontSize"

                    Value="14" />

            <Setter Property="FontWeight"

                    Value="SemiBold" />

            <Setter Property="Foreground"

                    Value="{DynamicResource ImmersiveTextMuted}" />

            <Setter Property="Background"

                    Value="{DynamicResource TransparentBrush}" />

            <Setter Property="BorderBrush"

                    Value="{DynamicResource TransparentBrush}" />

            <Setter Property="BorderThickness"

                    Value="0" />

        </Style>

    </Window.Resources>



    <Border CornerRadius="10"

            BorderBrush="{DynamicResource ImmersiveGlassBorder}"

            BorderThickness="1"

            Background="{DynamicResource ImmersiveGlassBackground}"

            ClipToBounds="True">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="36" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>



            <Border Grid.Row="0"

                    BorderBrush="{DynamicResource ImmersiveGlassBorder}"

                    BorderThickness="0,0,0,1"

                    Padding="14,0,8,0">

                <DockPanel PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown"

                           LastChildFill="True"

                           Cursor="Hand">

                    <Button x:Name="CloseTitleBarButton"

                            DockPanel.Dock="Right"

                            Content="✕"

                            Style="{StaticResource TitleBarCloseButton}"

                            Click="CloseTitleBar_Click" />

                    <TextBlock x:Name="TitleBarText"

                               Text="Useful website"

                               VerticalAlignment="Center"

                               FontSize="13"

                               FontWeight="SemiBold"

                               Foreground="{DynamicResource ImmersiveTextPrimary}" />

                </DockPanel>

            </Border>



            <TextBlock x:Name="HeaderText"

                       Grid.Row="1"

                       Text="Add useful website"

                       FontSize="18"

                       FontWeight="SemiBold"

                       Margin="18,14,18,12" />



            <StackPanel Grid.Row="2"

                        Margin="18,0">

                <TextBlock Text="Title *"

                           Style="{StaticResource FieldLabel}" />

                <TextBox x:Name="TitleBox"

                         Style="{StaticResource FieldTextBox}" />



                <TextBlock Text="Website URL *"

                           Style="{StaticResource FieldLabel}" />

                <TextBox x:Name="UrlBox"

                         Style="{StaticResource FieldTextBox}" />



                <TextBlock Text="Tags (comma-separated)"

                           Style="{StaticResource FieldLabel}" />

                <TextBox x:Name="TagsBox"

                         Style="{StaticResource FieldTextBox}"

                         Margin="0,0,0,6" />

                <TextBlock Text="Example: lab, portal, 3shape"

                           FontSize="11"

                           Foreground="{DynamicResource ImmersiveTextMuted}"

                           Margin="0,0,0,2" />

            </StackPanel>



            <StackPanel Grid.Row="3"

                        Orientation="Horizontal"

                        HorizontalAlignment="Right"

                        Margin="18,16,18,18">

                <Button Content="Cancel"

                        Style="{StaticResource SecondaryActionButton}"

                        Margin="0,0,8,0"

                        IsCancel="True"

                        Click="Cancel_Click" />

                <Button Content="Save"

                        Style="{StaticResource PrimaryActionButton}"

                        IsDefault="True"

                        Click="Save_Click" />

            </StackPanel>

        </Grid>

    </Border>

</Window>

