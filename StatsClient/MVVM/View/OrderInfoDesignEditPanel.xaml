<UserControl x:Class="StatsClient.MVVM.View.OrderInfoDesignEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converter="clr-namespace:StatsClient.MVVM.Converters"
             x:Name="Root"
             DataContext="{x:Null}">
    <UserControl.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVis" />
        <!-- Same image-knob sliders as DcmViewer sculpt panel (radius_icon / amplitude_icon). -->
        <Style x:Key="DesignEditSliderRepeatButton"
               TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="3"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DesignEditImageSliderThumb"
               TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Image Width="20"
                               Height="20"
                               Stretch="Uniform"
                               Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DesignEditSculptKnobSlider"
               TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28"
                              VerticalAlignment="Center"
                              Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DesignEditSliderRepeatButton}"
                                                  Background="{DynamicResource ViewerSliderTrackLight}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DesignEditSliderRepeatButton}"
                                                  Background="{DynamicResource ViewerSliderTrackDark}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DesignEditImageSliderThumb}"
                                           Tag="{TemplateBinding Tag}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DesignEditOffsetSlider"
               TargetType="Slider"
               BasedOn="{StaticResource DesignEditSculptKnobSlider}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22"
                              VerticalAlignment="Center"
                              Background="{DynamicResource TransparentBrush}">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DesignEditSliderRepeatButton}"
                                                  Background="{DynamicResource ViewerSliderTrackLight}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DesignEditSliderRepeatButton}"
                                                  Background="{DynamicResource ViewerSliderTrackDark}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14"
                                           Height="14"
                                           OverridesDefaultStyle="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource ImmersiveAccentBlueLight}"
                                                         Stroke="{DynamicResource ImmersiveAccentBlueBorder}"
                                                         StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DesignEditSculptToolButton"
               TargetType="Button"
               BasedOn="{StaticResource OrderInfoDesignEditToolButton}" />
    </UserControl.Resources>

    <Border Background="{DynamicResource GlassPanelBackground}"
            CornerRadius="4"
            BorderBrush="{DynamicResource GlassPanelBorder}"
            BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,8">
                <TextBlock Text="Design edit tools"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GlassPanelSectionTitleForeground}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Local edits only. DCM files are not modified."
                               TextWrapping="Wrap"
                               FontSize="10"
                               Foreground="{DynamicResource OrderInfoHintForeground}"
                               Margin="0,0,0,10" />

                <TextBlock Text="Sculpt"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GlassPanelSectionTitleForeground}"
                           Margin="0,0,0,6" />
                <StackPanel x:Name="SculptSection"
                            Margin="0,0,0,10">
                    <UniformGrid Columns="4"
                                 Margin="0,0,0,8">
                        <Button Command="{Binding SelectSculptToolCommand}"
                                CommandParameter="Add"
                                ToolTip="Add">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource DesignEditSculptToolButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SculptToolName}"
                                                     Value="Add">
                                            <Setter Property="Background"
                                                    Value="{StaticResource ImmersiveAccentBlueBorder}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource ImmersiveAccentBlue}" />
                                            <Setter Property="BorderThickness"
                                                    Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="/DcmViewer/Images/add.png"
                                   Width="20"
                                   Height="20" />
                        </Button>
                        <Button Command="{Binding SelectSculptToolCommand}"
                                CommandParameter="Remove"
                                ToolTip="Remove">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource DesignEditSculptToolButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SculptToolName}"
                                                     Value="Remove">
                                            <Setter Property="Background"
                                                    Value="{StaticResource ImmersiveAccentBlueBorder}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource ImmersiveAccentBlue}" />
                                            <Setter Property="BorderThickness"
                                                    Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="/DcmViewer/Images/remove.png"
                                   Width="20"
                                   Height="20" />
                        </Button>
                        <Button Command="{Binding SelectSculptToolCommand}"
                                CommandParameter="Smooth"
                                ToolTip="Smooth">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource DesignEditSculptToolButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SculptToolName}"
                                                     Value="Smooth">
                                            <Setter Property="Background"
                                                    Value="{StaticResource ImmersiveAccentBlueBorder}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource ImmersiveAccentBlue}" />
                                            <Setter Property="BorderThickness"
                                                    Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="/DcmViewer/Images/smooth.png"
                                   Width="20"
                                   Height="20" />
                        </Button>
                        <Button Command="{Binding SelectSculptToolCommand}"
                                CommandParameter="Grab"
                                Margin="0"
                                ToolTip="Grab">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource DesignEditSculptToolButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SculptToolName}"
                                                     Value="Grab">
                                            <Setter Property="Background"
                                                    Value="{StaticResource ImmersiveAccentBlueBorder}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource ImmersiveAccentBlue}" />
                                            <Setter Property="BorderThickness"
                                                    Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="/DcmViewer/Images/grab_move.png"
                                   Width="20"
                                   Height="20" />
                        </Button>
                    </UniformGrid>
                    <TextBlock Text="Radius (mm)"
                               FontSize="10"
                               Foreground="{DynamicResource OrderInfoHintForeground}"
                               Margin="0,0,0,2" />
                    <Slider Style="{StaticResource DesignEditSculptKnobSlider}"
                            Tag="/DcmViewer/Images/radius_icon.png"
                            Minimum="0.20"
                            Maximum="3"
                            Value="{Binding SculptBrushRadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="False"
                            Margin="0,0,0,2" />
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="10"
                               Foreground="{DynamicResource GlassPanelValueForeground}"
                               Margin="0,0,0,6"
                               Text="{Binding SculptBrushRadiusMm, StringFormat={}{0:0.00}}" />
                    <TextBlock Text="Strength"
                               FontSize="10"
                               Foreground="{DynamicResource OrderInfoHintForeground}"
                               Margin="0,0,0,2" />
                    <Slider Style="{StaticResource DesignEditSculptKnobSlider}"
                            Tag="/DcmViewer/Images/amplitude_icon.png"
                            Minimum="0.05"
                            Maximum="1"
                            Value="{Binding SculptBrushStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="False"
                            Margin="0,0,0,2" />
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="10"
                               Foreground="{DynamicResource GlassPanelValueForeground}"
                               Text="{Binding SculptBrushStrength, StringFormat={}{0:0.00}}" />
                    </StackPanel>

                    <Border Height="1"
                            Background="{DynamicResource GlassPanelBorder}"
                            Margin="0,0,0,10" />

                    <TextBlock Text="Cut plane"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GlassPanelSectionTitleForeground}"
                               Margin="0,0,0,6" />
                    <Button Content="Cut plane tool"
                            Command="{Binding ToggleCutPlaneModeCommand}"
                            Margin="0,0,0,6">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource OrderInfoDesignEditButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCutPlaneMode}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource ImmersiveAccentBlueBorder}" />
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource ImmersiveAccentBlue}" />
                                        <Setter Property="FontWeight"
                                                Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Slider Style="{StaticResource DesignEditOffsetSlider}"
                            Minimum="-1"
                            Maximum="1"
                            Value="{Binding CutPlaneOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TickFrequency="0.1"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsCutPlaneMode, Converter={StaticResource BoolToVis}}" />
                    <UniformGrid Columns="2"
                                 Margin="0,0,0,10">
                        <Button Content="Flip side"
                                Style="{StaticResource OrderInfoDesignEditButton}"
                                Command="{Binding FlipCutPlaneSideCommand}"
                                Margin="0,0,4,0" />
                        <Button Content="Apply cut"
                                Style="{StaticResource OrderInfoDesignEditAccentButton}"
                                Command="{Binding ApplyCutPlaneCommand}"
                                Margin="0"
                                FontWeight="SemiBold" />
                    </UniformGrid>

                    <Button Content="Save STL"
                            Style="{StaticResource OrderInfoDesignEditAccentButton}"
                            Command="{Binding SaveDesignEditStlCommand}"
                            FontWeight="SemiBold"
                            ToolTip="StatsDesignEdit/Exports — DCM untouched." />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
