<Window x:Class="StatsClient.MVVM.View.StatsDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dcm="clr-namespace:DCMViewer.Controls"
        xmlns:dcvm="clr-namespace:DCMViewer.ViewModels"
        xmlns:vm="clr-namespace:StatsClient.MVVM.ViewModel"
        xmlns:ctrl="clr-namespace:StatsClient.MVVM.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Stats Design"
        Height="900"
        Width="1500"
        MinHeight="640"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource PrimaryDarkColor}">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="5"
                      CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <SolidColorBrush x:Key="GlassPanelBackground" Color="#6636404A" />
            <SolidColorBrush x:Key="GlassPanelBorder" Color="#88A8B0B8" />
            <SolidColorBrush x:Key="GlassPanelLabelForeground" Color="#B8C0C8" />
            <SolidColorBrush x:Key="GlassPanelValueForeground" Color="#F2F6FA" />
            <Style x:Key="DesignPanelButton" TargetType="Button" BasedOn="{StaticResource BlankButton}">
                <Setter Property="Background" Value="{StaticResource VitaButtonBackgroundDark}" />
                <Setter Property="Foreground" Value="{StaticResource WhiteBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource VitaButtonBorderLight}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="DesignTitleChromeButton" TargetType="Border">
                <Setter Property="Width" Value="65" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Background" Value="{DynamicResource DialogCloseButtonBackground}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource VitaButtonBackgroundDark}" />
                <Setter Property="Foreground" Value="{StaticResource WhiteBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource VitaButtonBorderLight}" />
                <Setter Property="CaretBrush" Value="{StaticResource WhiteBackground}" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource GlassPanelLabelForeground}" />
            </Style>
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{StaticResource VitaButtonBackgroundDark}" />
                <Setter Property="Foreground" Value="{StaticResource WhiteBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource VitaButtonBorderLight}" />
            </Style>
            <Style x:Key="WorkflowStepButton" TargetType="Button" BasedOn="{StaticResource BlankButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="WorkflowStepIconBorder" TargetType="Border">
                <Setter Property="Width" Value="50" />
                <Setter Property="Height" Value="50" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource VitaButtonBorderLight}" />
                <Setter Property="Background" Value="{StaticResource VitaButtonBackgroundDark}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <vm:StatsDesignViewModel />
    </Window.DataContext>

    <Border x:Name="OuterChromeBorder"
            CornerRadius="8,8,4,8"
            BorderThickness="0.5"
            BorderBrush="{DynamicResource BlackColor}"
            Background="{DynamicResource PrimaryDarkColor}"
            ClipToBounds="True">
        <Border x:Name="InnerChromeBorder"
                CornerRadius="8"
                Margin="10"
                BorderThickness="0.5"
                BorderBrush="{DynamicResource BlackColor}"
                Background="{DynamicResource PrimaryColor}"
                ClipToBounds="True">
            <Grid Margin="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,6">
                    <Border BorderBrush="{DynamicResource VitaButtonBorderLight}"
                            BorderThickness="0,0,0,1"
                            Background="Transparent"
                            PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                        <TextBlock Text="{Binding WindowTitle}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,150,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OrderInfoPtNameColor}"
                                   IsHitTestVisible="False" />
                    </Border>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,-10,-7,0">
                        <Border Style="{StaticResource DesignTitleChromeButton}"
                                CornerRadius="9,0,0,0"
                                ToolTip="{Binding FullscreenButtonLabel}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseDown">
                                    <i:InvokeCommandAction Command="{Binding ToggleFullscreenCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <TextBlock Text="&#xE740;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource WhiteBackground}" />
                        </Border>
                        <Border Style="{StaticResource DesignTitleChromeButton}"
                                CornerRadius="0,9,0,0"
                                ToolTip="Close">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseDown">
                                    <i:InvokeCommandAction Command="{Binding CloseWindowCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <TextBlock Text="&#x2573;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource WhiteBackground}"
                                       FontWeight="Bold"
                                       FontSize="16" />
                        </Border>
                    </StackPanel>
                </Grid>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="300" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        Background="{DynamicResource PrimaryDarkColor}"
                        BorderBrush="{DynamicResource VitaButtonBorderLight}"
                        BorderThickness="1"
                        CornerRadius="6">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Margin="12,10">
                        <ScrollViewer.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource DesignPanelButton}" />
                        </ScrollViewer.Resources>

                        <StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource DesignPanelButton}"
                                        Content="◀ Back"
                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.DesignWorkflowBackCommand}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource DesignPanelButton}"
                                        Content="Next ▶"
                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.DesignWorkflowNextCommand}" />
                            </Grid>

                            <TextBlock Text="DESIGN MESH (OPTIONAL)"

                                       FontSize="10"

                                       FontWeight="SemiBold"

                                       Foreground="{DynamicResource GlassPanelLabelForeground}" />

                            <TextBlock Text="Scans load automatically. Pick an existing CAD / StatsCAD file to load, or generate a new shell on the Cement step."

                                       TextWrapping="Wrap"

                                       Margin="0,4,0,8"

                                       FontSize="11"

                                       Foreground="{DynamicResource GlassPanelLabelForeground}" />

                            <CheckBox Content="Restore last loaded design on open"

                                      IsChecked="{Binding RestoreLastDesignOnOpen, Mode=TwoWay}"

                                      Margin="0,0,0,8"

                                      FontSize="11" />

                            <ListBox x:Name="DesignFilesList"

                                     ItemsSource="{Binding ElementName=DesignViewer, Path=ViewerViewModel.AvailableDesignFiles}"

                                     SelectedItem="{Binding ElementName=DesignViewer, Path=ViewerViewModel.SelectedDesignFile, Mode=TwoWay}"

                                     DisplayMemberPath="DisplayName"

                                     MaxHeight="120"

                                     Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource DesignPanelButton}"
                                        Content="Load"
                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LoadSelectedDesignCommand}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource DesignPanelButton}"
                                        Content="Unload design"
                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.UnloadDesignCommand}" />
                            </Grid>



                            <StackPanel Visibility="{Binding IsMarginStep, Converter={StaticResource BoolToVis}}">

                                <TextBlock Text="Margin line"

                                           FontWeight="SemiBold"

                                           Foreground="{DynamicResource GlassPanelValueForeground}" />

                                <TextBlock Text="{Binding ElementName=DesignViewer, Path=ViewerViewModel.MarginStatusText}"

                                           TextWrapping="Wrap"

                                           Margin="0,6,0,8"

                                           FontSize="11"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBlock Text="Left-click to place points. With 3+ points, drag on the prep to reshape one section — the rest of the margin stays. Click near the existing line to start from that spot. Close loop when done. Right-click drag rotates."

                                           TextWrapping="Wrap"

                                           FontSize="11"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <UniformGrid Columns="3"
                                             Margin="0,10,0,0">
                                    <Button Content="Undo"
                                            Margin="2"
                                            Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.UndoMarginPointCommand}" />
                                    <Button Content="Clear"
                                            Margin="2"
                                            Click="ClearMarginButton_Click" />
                                    <Button Content="Close loop"
                                            Margin="2"
                                            Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.CloseMarginLoopCommand}" />
                                </UniformGrid>

                                <TextBlock Text="{Binding ElementName=DesignViewer, Path=ViewerViewModel.UndercutStatusText}"

                                           TextWrapping="Wrap"

                                           Margin="0,10,0,4"

                                           FontSize="11"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <Button Content="Analyze undercuts"
                                        Margin="0,8,0,0"
                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.AnalyzeUndercutsCommand}" />

                            </StackPanel>



                            <StackPanel Visibility="{Binding IsInnerStep, Converter={StaticResource BoolToVis}}">

                                <TextBlock Text="Inner shell (open)"

                                           FontWeight="SemiBold"

                                           Foreground="{DynamicResource GlassPanelValueForeground}" />

                                <TextBlock Text="Yellow open surface = cement space inside the margin. Separate file from the final closed crown."

                                           TextWrapping="Wrap"

                                           Margin="0,6,0,8"

                                           FontSize="11"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBlock Text="Cement gap (mm)"

                                           Margin="0,10,0,2"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.CementGapMm, Mode=TwoWay}"
                                                               Step="{Binding NumericStep}"
                                                               DecimalPlaces="{Binding NumericDecimals}"
                                                               Minimum="0"
                                                               Maximum="0.5" />

                                <TextBlock Text="Extra cement gap (mm)"

                                           Margin="0,8,0,2"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.ExtraCementGapMm, Mode=TwoWay}"
                                                               Step="{Binding NumericStep}"
                                                               DecimalPlaces="{Binding NumericDecimals}"
                                                               Minimum="0"
                                                               Maximum="2" />

                                <TextBlock Text="Smooth distance (mm)"

                                           Margin="0,8,0,2"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.SmoothDistanceMm, Mode=TwoWay}"
                                                               Step="{Binding NumericStep}"
                                                               DecimalPlaces="{Binding NumericDecimals}"
                                                               Minimum="0"
                                                               Maximum="1" />

                                <TextBlock Text="Minimum thickness (mm)"

                                           Margin="0,8,0,2"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.MinimumThicknessMm, Mode=TwoWay}"
                                                               Step="0.05"
                                                               DecimalPlaces="{Binding NumericDecimals}"
                                                               Minimum="0.2"
                                                               Maximum="3" />

                                <TextBlock Text="Gap ramp from margin (mm)"

                                           Margin="0,8,0,2"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBlock Text="Width of the transition from zero gap at the margin line to full cement gap. Sharp prep corners get extra clearance (smooth distance)."

                                           TextWrapping="Wrap"

                                           Margin="0,0,0,2"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.OffsetFromMarginMm, Mode=TwoWay}"
                                                               Step="0.1"
                                                               DecimalPlaces="{Binding NumericDecimals}"
                                                               Minimum="0"
                                                               Maximum="3" />

                                <TextBlock Text="Requires a closed margin loop from the Margin step."

                                           TextWrapping="Wrap"

                                           Margin="0,10,0,4"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBlock Text="{Binding ElementName=DesignViewer, Path=ViewerViewModel.InnerShellStatusText}"

                                           TextWrapping="Wrap"

                                           Margin="0,4,0,6"

                                           FontSize="11"

                                           Foreground="{DynamicResource GlassPanelValueForeground}" />

                                <Button Content="Generate inner shell"

                                        Margin="0,6,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.GenerateInnerShellCommand}" />

                                <Button Content="Block seat-path undercuts (inner)"

                                        Margin="0,6,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.BlockInnerUndercutsCommand}" />

                            </StackPanel>



                            <StackPanel Visibility="{Binding IsShapeStep, Converter={StaticResource BoolToVis}}">

                                <TextBlock Text="Place library tooth"

                                           FontWeight="SemiBold"

                                           Foreground="{DynamicResource GlassPanelValueForeground}" />

                                <TextBlock Text="Pick a tooth from Smile Libraries, move and scale it, then Connect. The crown is cut at the library margin spline; the gap to your margin line is filled automatically."

                                           TextWrapping="Wrap"

                                           Margin="0,6,0,8"

                                           FontSize="11"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBlock Text="Tooth #"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <ComboBox ItemsSource="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LibraryTeeth}"

                                          SelectedItem="{Binding ElementName=DesignViewer, Path=ViewerViewModel.SelectedLibraryTooth, Mode=TwoWay}"

                                          DisplayMemberPath="DisplayName"

                                          MinHeight="28"

                                          Margin="0,2,0,4" />

                                <TextBlock Text="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LibraryCatalogStatus}"

                                           TextWrapping="Wrap"

                                           FontSize="10"

                                           Margin="0,0,0,8"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <Button Content="Load / replace tooth"

                                        Padding="8,5"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LoadLibraryToothCommand}" />

                                <TextBlock Text="Offset (mm)"

                                           Margin="0,10,0,2"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <UniformGrid Columns="3" Margin="0,0,0,6">

                                    <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LibraryOffsetXmm, Mode=TwoWay}" Step="{Binding NumericStep}" DecimalPlaces="{Binding NumericDecimals}" Margin="0,0,4,0" />

                                    <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LibraryOffsetYmm, Mode=TwoWay}" Step="{Binding NumericStep}" DecimalPlaces="{Binding NumericDecimals}" Margin="0,0,4,0" />

                                    <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LibraryOffsetZmm, Mode=TwoWay}" Step="{Binding NumericStep}" DecimalPlaces="{Binding NumericDecimals}" />

                                </UniformGrid>

                                <TextBlock Text="Scale X / Y / Z"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <UniformGrid Columns="3" Margin="0,2,0,6">

                                    <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LibraryScaleX, Mode=TwoWay}" Step="0.05" DecimalPlaces="{Binding NumericDecimals}" Minimum="0.2" Maximum="3" Margin="0,0,4,0" />

                                    <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LibraryScaleY, Mode=TwoWay}" Step="0.05" DecimalPlaces="{Binding NumericDecimals}" Minimum="0.2" Maximum="3" Margin="0,0,4,0" />

                                    <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LibraryScaleZ, Mode=TwoWay}" Step="0.05" DecimalPlaces="{Binding NumericDecimals}" Minimum="0.2" Maximum="3" />

                                </UniformGrid>

                                <TextBlock Text="Uniform scale"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <ctrl:StatsDesignNumericUpDown Value="{Binding ElementName=DesignViewer, Path=ViewerViewModel.LibraryUniformScale, Mode=TwoWay}"

                                                               Step="0.05"

                                                               DecimalPlaces="{Binding NumericDecimals}"

                                                               Minimum="0.2"

                                                               Maximum="3"

                                                               Margin="0,2,0,10" />

                                <Button Content="Connect to margin line"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.ConnectToMarginCommand}" />

                            </StackPanel>



                            <StackPanel Visibility="{Binding IsSculptStep, Converter={StaticResource BoolToVis}}">

                                <TextBlock Text="Sculpt"

                                           FontWeight="SemiBold"

                                           Foreground="{DynamicResource GlassPanelValueForeground}" />

                                <TextBlock Text="Sculpt the closed Zirconia crown only. Inner shell and library preview cannot be sculpted. Scans stay locked."

                                           TextWrapping="Wrap"

                                           Margin="0,6,0,0"

                                           FontSize="11"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBlock Text="Use the tools on the right: add, remove, smooth, grab. Undo with Ctrl+Z."

                                           TextWrapping="Wrap"

                                           Margin="0,8,0,0"

                                           FontSize="11"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBlock Text="Safety &amp; contacts"

                                           FontWeight="SemiBold"

                                           Margin="0,14,0,4"

                                           Foreground="{DynamicResource GlassPanelValueForeground}" />

                                <TextBlock Text="{Binding ElementName=DesignViewer, Path=ViewerViewModel.SafetyStatusText}"

                                           TextWrapping="Wrap"

                                           FontSize="11"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <Button Content="Enforce minimum thickness"

                                        Margin="0,10,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.EnforceMinimumThicknessCommand}" />

                                <Button Content="Toggle contact heatmap"

                                        Margin="0,6,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.ToggleContactHeatmapCommand}" />

                                <Button Content="Toggle thickness breach overlay (live)"

                                        Margin="0,6,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.ToggleThicknessBreachOverlayCommand}" />

                                <TextBlock Text="Magenta = wall thinner than minimum. Updates after each sculpt stroke when overlay is on."

                                           TextWrapping="Wrap"

                                           Margin="0,4,0,0"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <Button Content="Run pre-export validation"

                                        Margin="0,10,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.RunCrownValidationCommand}" />

                                <TextBlock Text="{Binding ElementName=DesignViewer, Path=ViewerViewModel.ValidationStatusText}"

                                           TextWrapping="Wrap"

                                           Margin="0,6,0,0"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBlock Text="Heatmap: red = tight, green = ideal contact, blue = open gap (vs other scans)."

                                           TextWrapping="Wrap"

                                           Margin="0,6,0,0"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBlock Text="Advanced shaping"

                                           FontWeight="SemiBold"

                                           Margin="0,14,0,4"

                                           Foreground="{DynamicResource GlassPanelValueForeground}" />

                                <TextBlock Text="Occlusal clearance (mm)"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBox Text="{Binding ElementName=DesignViewer, Path=ViewerViewModel.OcclusalClearanceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                         Padding="4,2"

                                         Margin="0,2,0,0" />

                                <TextBlock Text="Emergence height (mm)"

                                           Margin="0,6,0,2"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBox Text="{Binding ElementName=DesignViewer, Path=ViewerViewModel.EmergenceTransitionMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                         Padding="4,2" />

                                <Button Content="Block seat undercuts (crown)"

                                        Margin="0,10,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.BlockCrownSeatUndercutsCommand}" />

                                <Button Content="Adapt occlusion (opposing scan)"

                                        Margin="0,6,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.AdaptOcclusionCommand}" />

                                <Button Content="Generate emergence profile"

                                        Margin="0,6,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.GenerateEmergenceProfileCommand}" />

                                <Button Content="Trim proximal contacts"

                                        Margin="0,6,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.TrimProximalContactsCommand}" />

                            </StackPanel>



                            <StackPanel Visibility="{Binding IsExportStep, Converter={StaticResource BoolToVis}}">

                                <TextBlock Text="Export STL"

                                           FontWeight="SemiBold"

                                           Foreground="{DynamicResource GlassPanelValueForeground}" />

                                <TextBlock Text="Writes StatsCAD\{design}.stl under the order folder and updates StatsDesign\manifest.json."

                                           TextWrapping="Wrap"

                                           Margin="0,6,0,0"

                                           FontSize="11"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBlock Text="Design file name"

                                           Margin="0,10,0,2"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <TextBox Text="{Binding ElementName=DesignViewer, Path=ViewerViewModel.DesignName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                         Padding="4,2" />

                                <TextBlock Text="{Binding ElementName=DesignViewer, Path=ViewerViewModel.ValidationStatusText}"

                                           TextWrapping="Wrap"

                                           Margin="0,10,0,0"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                                <Button Content="Export design STL"

                                        Margin="0,10,0,0"

                                        Padding="10,6"

                                        HorizontalAlignment="Stretch"

                                        Command="{Binding ElementName=DesignViewer, Path=ViewerViewModel.ExportDesignStlCommand}" />

                                <TextBlock Text="Export runs validation first (watertight shell, thickness, seat path)."

                                           TextWrapping="Wrap"

                                           Margin="0,6,0,0"

                                           FontSize="10"

                                           Foreground="{DynamicResource GlassPanelLabelForeground}" />

                            </StackPanel>

                        </StackPanel>

                    </ScrollViewer>

                </Border>



                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,8"
                            Padding="8,6"
                            Background="#5536404A"
                            BorderBrush="{DynamicResource VitaButtonBorderLight}"
                            BorderThickness="1"
                            CornerRadius="6"
                            HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding WorkflowSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StatsDesignWorkflowStepItem}">
                                    <Button Style="{StaticResource WorkflowStepButton}"
                                            Command="{Binding DataContext.SelectWorkflowStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding StepKey}">
                                        <StackPanel Width="72">
                                            <Border Width="50"
                                                    Height="50"
                                                    CornerRadius="8"
                                                    BorderThickness="1"
                                                    BorderBrush="{StaticResource VitaButtonBorderLight}"
                                                    Background="{StaticResource VitaButtonBackgroundDark}"
                                                    HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#E8F0F8" />
                                                                <Setter Property="Background" Value="#66708090" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="26"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource WhiteBackground}" />
                                            </Border>
                                            <TextBlock Text="{Binding Label}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0"
                                                       FontSize="11"
                                                       TextAlignment="Center"
                                                       Foreground="{Binding IsCurrentBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <dcm:DcmViewerCanvasComponent x:Name="DesignViewer"
                                                  Grid.Row="1"
                                                  HostMode="{x:Static dcvm:ViewerHostMode.Design}"
                                                  UseFullAppShell="True"
                                                  IsBackgroundTransparent="True"
                                                  IsWatermarkVisible="False" />
                </Grid>

            </Grid>
            </Grid>
        </Border>
    </Border>
</Window>

