<UserControl x:Class="StatsClient.MVVM.View.OrderInfoDesignEditStepsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             DataContext="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="DesignEditStepsActionButton"
               TargetType="Button">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="{DynamicResource PrimaryDarkColor}" />
            <Setter Property="Foreground" Value="{DynamicResource BlackColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassPanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,10">
            <TextBlock Text="Design edit steps"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource GlassPanelSectionTitleForeground}" />
            <TextBlock Text="Saved locally under StatsDesignEdit. Reopens with this order."
                       TextWrapping="Wrap"
                       FontSize="10"
                       Foreground="{DynamicResource OrderInfoHintForeground}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource TransparentBrush}"
                BorderBrush="{DynamicResource GlassPanelBorder}"
                BorderThickness="1"
                CornerRadius="3"
                MinHeight="120">
            <ListView x:Name="StepsList"
                      ItemsSource="{Binding DesignEditSteps}"
                      BorderThickness="0"
                      Background="{DynamicResource TransparentBrush}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,0,0,1" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding StepNumber}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlassPanelLabelForeground}"
                                       VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource GlassPanelValueForeground}"
                                           FontSize="11" />
                                <TextBlock Text="{Binding Detail}"
                                           TextWrapping="Wrap"
                                           FontSize="10"
                                           Foreground="{DynamicResource OrderInfoHintForeground}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,10,0,0">
            <UniformGrid Columns="2"
                         Margin="0,0,0,6">
                <Button Content="Undo"
                        Style="{StaticResource DesignEditStepsActionButton}"
                        Command="{Binding UndoDesignEditCommand}"
                        Margin="0,0,4,0"
                        ToolTip="Undo last step (Ctrl+Z)" />
                <Button Content="Redo"
                        Style="{StaticResource DesignEditStepsActionButton}"
                        Command="{Binding RedoDesignEditCommand}"
                        ToolTip="Redo step (Ctrl+Y)" />
            </UniformGrid>
            <Button Content="Undo all"
                    Style="{StaticResource DesignEditStepsActionButton}"
                    Command="{Binding UndoAllDesignEditCommand}"
                    ToolTip="Remove every saved step and restore the original 3Shape design" />
        </StackPanel>
    </Grid>
</UserControl>
