<Window x:Class="StatsClient.MVVM.View.SMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodel="clr-namespace:StatsClient.MVVM.ViewModel"
        xmlns:core="clr-namespace:StatsClient.MVVM.Core"
        xmlns:converter="clr-namespace:StatsClient.MVVM.Converters"
        xmlns:localView="clr-namespace:StatsClient.MVVM.View"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Stats Client"
        Height="150"
        Width="400"
        MinHeight="150"
        MinWidth="400"
        MaxWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowState="Normal"
        Loaded="Window_Loaded"
        AllowsTransparency="True"
        Foreground="{DynamicResource MessageBoxBodyForeground}">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="5,5,5,5"
                      CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MessageBoxButtonPrimary" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="{DynamicResource MessageBoxButtonPrimaryBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource MessageBoxButtonPrimaryForeground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MessageBoxButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource VitaButtonAccentGold}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MessageBoxButtonSecondary" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="{DynamicResource MessageBoxButtonSecondaryBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource MessageBoxButtonSecondaryForeground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MessageBoxButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource VitaButtonHoverGray}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Background>
        <SolidColorBrush Opacity="0.95" />
    </Window.Background>

    <Border CornerRadius="8,8,4,8"
            BorderThickness="1"
            BorderBrush="{DynamicResource MessageBoxBorderBrush}"
            Background="{DynamicResource MessageBoxBackground}"
            Opacity="0.98"
            ClipToBounds="True">

        <Grid>
            <Ellipse Fill="{DynamicResource MessageBoxAccentColor}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Width="4000"
                     Height="80"
                     Panel.ZIndex="1"
                     Opacity="0.28"
                     Margin="-50,0"
                     RenderTransformOrigin="0.5, 0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="noFreeze"
                                     Angle="0" />
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                                 To="360"
                                                 Duration="0:0:6"
                                                 RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Border CornerRadius="8,8,4,8"
                    BorderThickness="0.65"
                    BorderBrush="{DynamicResource MessageBoxTitleBorder}"
                    Panel.ZIndex="10"
                    Opacity="1"
                    Margin="4"
                    ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5"
                                         EndPoint="1,0.5">
                        <GradientStop Color="{DynamicResource MessageBoxHeaderGradientStart}"
                                      Offset="0.0" />
                        
                        <GradientStop Color="{DynamicResource MessageBoxHeaderGradientEnd}"
                                      Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Image Source="{Binding SMessageBoxIcon}"
                           d:Source="/Images/MessageIcons/Info.png"
                           Width="250"
                           Height="250"
                           Panel.ZIndex="0"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                           Opacity="0.15"
                           Margin="-80,-40,0,-80" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="26" />
                            <RowDefinition />
                            <RowDefinition Height="50" />
                        </Grid.RowDefinitions>



                        <Border Grid.Row="0"
                                Background="{DynamicResource TransparentBrush}"
                                BorderBrush="{DynamicResource MessageBoxTitleBorder}"
                                CornerRadius="8,8,0,0"
                                ClipToBounds="True"
                                Cursor="Hand"
                                BorderThickness="0,0,0,1"
                                PreviewMouseLeftButtonDown="Border_PreviewMouseLeftButtonDown">
                            <DockPanel>
                                <Image Source="{Binding SMessageBoxIcon}"
                                       d:Source="/Images/MessageIcons/Info.png"
                                       Width="28"
                                       Height="28"
                                       Margin="-2,-2,-2,0"
                                       ClipToBounds="True"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding SMessageTitle}"
                                           d:Text="Message Title"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MessageBoxTitleForeground}"
                                           Padding="2,2"
                                           Margin="0,0,0,0"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock d:Text="113"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MessageBoxSubtitleForeground}"
                                           FontSize="10"
                                           x:Name="countDownTimer"
                                           Margin="6,0" />
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Message body Lorem Ipsum is simply dummy text of the printing and typesetting industry. "
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Padding="26,4,6,4"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MessageBoxBodyForeground}"
                                       FontSize="15"
                                       Visibility="Collapsed"
                                       d:Visibility="Visible"
                                       FontFamily="Arial" />

                            <core:OutlinedTextBlock Stroke="{DynamicResource MessageBoxHintForeground}"
                                                    StrokePosition="Outside"
                                                    FontSize="15"
                                                    FontFamily="Arial"
                                                    VerticalAlignment="Center"
                                                    TextWrapping="Wrap"
                                                    FontWeight="Normal"
                                                    Fill="{DynamicResource MessageBoxBodyFill}"
                                                    StrokeThickness="0.35"
                                                    Margin="26,4,6,4"
                                                    Grid.Column="1"
                                                    Text="{Binding SMessageBody}" />
                        </Grid>



                        <Grid Grid.Row="2"
                              Margin="4,0"
                              Height="34"
                              VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>



                            <Button Content="{Binding SMessageButtonLeftContent}"
                                    d:Content="Yes"
                                    Style="{StaticResource MessageBoxButtonPrimary}"
                                    Visibility="{Binding SMessageButtonLeftVisibility}"
                                    d:Visibility="Visible"
                                    Command="{Binding SMessageButtonClickCommand}"
                                    CommandParameter="{Binding ElementName=xLeftButton, Path=Content}"
                                    Grid.Column="1"
                                    x:Name="xLeftButton"
                                    Margin="4,8,4,0"
                                    Width="150" />

                            <Button Content="{Binding SMessageButtonRightContent}"
                                    d:Content="No"
                                    Style="{StaticResource MessageBoxButtonSecondary}"
                                    Visibility="{Binding SMessageButtonRightVisibility}"
                                    d:Visibility="Visible"
                                    Command="{Binding SMessageButtonClickCommand}"
                                    CommandParameter="{Binding ElementName=xRightButton, Path=Content}"
                                    Grid.Column="2"
                                    x:Name="xRightButton"
                                    Margin="4,8,4,0"
                                    Width="150" />

                        </Grid>

                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
