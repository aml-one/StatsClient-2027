<Window x:Class="StatsClient.MVVM.View.ArchiveImportChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import order"
        Height="300"
        Width="420"
        MinHeight="280"
        MinWidth="380"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource TransparentBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="0"
                      CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ArchiveImportActionButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource GrabANumberButtonColor}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource LightTextColor}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource GrabANumberButtonColor}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Padding"
                    Value="14,10" />
            <Setter Property="MinHeight"
                    Value="40" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveImportSecondaryButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource ImmersiveGlassBackground}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource ImmersiveTextPrimary}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ImmersiveGlassBorder}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Padding"
                    Value="14,8" />
            <Setter Property="MinHeight"
                    Value="34" />
            <Setter Property="MinWidth"
                    Value="88" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource ImmersiveGlassBorder}"
            Background="{DynamicResource ClassicWindowBackgroundBrush}"
            ClipToBounds="True">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ImmersiveGlassBackground}"
                    BorderBrush="{DynamicResource ImmersiveGlassBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0"
                    Padding="10,8"
                    Margin="-14,-14,-14,10"
                    PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Import order"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ImmersiveTextPrimary}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CloseButton"
                               Text="╳"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Cursor="Hand"
                               Foreground="{DynamicResource ImmersiveTextMuted}"
                               ToolTip="Cancel"
                               PreviewMouseLeftButtonDown="CloseButton_PreviewMouseLeftButtonDown" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="How do you want to import this archive order?"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ImmersiveTextPrimary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <StackPanel Grid.Row="2"
                        VerticalAlignment="Top">
                <Button Content="Import into 3Shape"
                        Style="{StaticResource ArchiveImportActionButton}"
                        Margin="0,0,0,8"
                        Click="ImportStandard_Click" />
                <Button Content="Import into 3Shape with new Pan Number"
                        Style="{StaticResource ArchiveImportActionButton}"
                        Click="ImportWithNewPan_Click" />
            </StackPanel>

            <Button Grid.Row="3"
                    Content="Cancel"
                    Style="{StaticResource ArchiveImportSecondaryButton}"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Click="Cancel_Click" />
        </Grid>
    </Border>
</Window>
