<Window x:Class="StatsClient.MVVM.View.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodel="clr-namespace:StatsClient.MVVM.ViewModel"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        Title="Stats 2027"
        Height="340"
        Width="620"
        Background="{DynamicResource TransparentBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <QuarticEase x:Key="QuarticEaseOut"
                         EasingMode="EaseOut" />
            <QuarticEase x:Key="QuarticEaseInOut"
                         EasingMode="EaseInOut" />
            <BackEase x:Key="BackEaseOut"
                      EasingMode="EaseOut"
                      Amplitude="0.25" />
            <SineEase x:Key="SineEaseInOut"
                      EasingMode="EaseInOut" />
            <CubicEase x:Key="CubicEaseOut"
                       EasingMode="EaseOut" />

            <!-- Dark-mode-aligned splash palette -->
            <Color x:Key="SsmsDeepNavy">#283445</Color>
            <Color x:Key="SsmsRoyalBlue">#0369A1</Color>
            <Color x:Key="SsmsSkyBlue">#4A7290</Color>
            <Color x:Key="SsmsLightBlue">#5A8EB0</Color>
            <Color x:Key="SsmsHighlight">#5599B8</Color>
            <Color x:Key="SsmsWaveBlue">#2D6588</Color>
            <Color x:Key="SsmsAccentCyan">#38BDF8</Color>
            <Color x:Key="SsmsYearAccent">#FB923C</Color>
            <SolidColorBrush x:Key="SsmsWhiteBrush"
                             Color="White" />
            <SolidColorBrush x:Key="SsmsMutedWhiteBrush"
                             Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="SsmsHighlightBrush"
                             Color="{StaticResource SsmsHighlight}" />
            <SolidColorBrush x:Key="SsmsYearAccentBrush"
                             Color="{StaticResource SsmsYearAccent}" />

            <!-- Background ribbon parallax / undulation -->
            <Storyboard x:Key="RibbonBackgroundAnimation"
                        RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="ribbonBackTransform"
                                 Storyboard.TargetProperty="Y"
                                 From="-3"
                                 To="4"
                                 Duration="0:0:7"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
                <DoubleAnimation Storyboard.TargetName="ribbonMidTransform"
                                 Storyboard.TargetProperty="X"
                                 From="-4"
                                 To="4"
                                 Duration="0:0:9"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
                <DoubleAnimation Storyboard.TargetName="ribbonMidTransform"
                                 Storyboard.TargetProperty="Y"
                                 From="2"
                                 To="-3"
                                 Duration="0:0:8"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
                <DoubleAnimation Storyboard.TargetName="ribbonFrontTransform"
                                 Storyboard.TargetProperty="Angle"
                                 From="-0.8"
                                 To="0.8"
                                 Duration="0:0:6.5"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
                <DoubleAnimation Storyboard.TargetName="ribbonHighlightTransform"
                                 Storyboard.TargetProperty="X"
                                 From="-3"
                                 To="5"
                                 Duration="0:0:5.5"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
                <DoubleAnimation Storyboard.TargetName="ribbonHighlightTransform"
                                 Storyboard.TargetProperty="Y"
                                 From="2"
                                 To="-3"
                                 Duration="0:0:6"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
                <DoubleAnimation Storyboard.TargetName="ribbonLightStop1"
                                 Storyboard.TargetProperty="Offset"
                                 From="0.05"
                                 To="0.35"
                                 Duration="0:0:5"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
                <DoubleAnimation Storyboard.TargetName="ribbonLightStop2"
                                 Storyboard.TargetProperty="Offset"
                                 From="0.45"
                                 To="0.85"
                                 Duration="0:0:5"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
            </Storyboard>

            <Storyboard x:Key="TitleRevealAnimation">
                <DoubleAnimation Storyboard.TargetName="titleBlock"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.9"
                                 EasingFunction="{StaticResource QuarticEaseOut}" />
                <DoubleAnimation Storyboard.TargetName="titleBlock"
                                 Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                                 From="16"
                                 To="0"
                                 Duration="0:0:0.9"
                                 EasingFunction="{StaticResource CubicEaseOut}" />
            </Storyboard>

            <!-- Logo: glow pulse, scale assemble, slide up -->
            <Storyboard x:Key="LogoAssembleAnimation">
                <DoubleAnimation Storyboard.TargetName="logoGlow"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="0.55"
                                 Duration="0:0:0.35"
                                 EasingFunction="{StaticResource QuarticEaseOut}" />
                <DoubleAnimation Storyboard.TargetName="logo"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.75"
                                 BeginTime="0:0:0.08"
                                 EasingFunction="{StaticResource QuarticEaseOut}" />
                <DoubleAnimation Storyboard.TargetName="logo"
                                 Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                 From="0.55"
                                 To="1"
                                 Duration="0:0:0.75"
                                 BeginTime="0:0:0.08"
                                 EasingFunction="{StaticResource BackEaseOut}" />
                <DoubleAnimation Storyboard.TargetName="logo"
                                 Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                 From="0.55"
                                 To="1"
                                 Duration="0:0:0.75"
                                 BeginTime="0:0:0.08"
                                 EasingFunction="{StaticResource BackEaseOut}" />
                <DoubleAnimation Storyboard.TargetName="logo"
                                 Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                 From="18"
                                 To="0"
                                 Duration="0:0:0.75"
                                 BeginTime="0:0:0.08"
                                 EasingFunction="{StaticResource CubicEaseOut}" />
                <DoubleAnimation Storyboard.TargetName="brandText"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.55"
                                 BeginTime="0:0:0.35"
                                 EasingFunction="{StaticResource QuarticEaseOut}" />
                <DoubleAnimation Storyboard.TargetName="brandText"
                                 Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)"
                                 From="-12"
                                 To="0"
                                 Duration="0:0:0.55"
                                 BeginTime="0:0:0.35"
                                 EasingFunction="{StaticResource CubicEaseOut}" />
            </Storyboard>

            <Storyboard x:Key="LogoIdleAnimation"
                        RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="logo"
                                 Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                 From="1"
                                 To="1.035"
                                 Duration="0:0:2.4"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
                <DoubleAnimation Storyboard.TargetName="logo"
                                 Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                 From="1"
                                 To="1.035"
                                 Duration="0:0:2.4"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
                <DoubleAnimation Storyboard.TargetName="logoGlow"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.35"
                                 To="0.65"
                                 Duration="0:0:2.4"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
            </Storyboard>

            <Storyboard x:Key="VersionRevealAnimation">
                <DoubleAnimation Storyboard.TargetName="versionNumber"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.8"
                                 BeginTime="0:0:0.2"
                                 EasingFunction="{StaticResource QuarticEaseOut}" />
                <DoubleAnimation Storyboard.TargetName="versionNumber"
                                 Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                                 From="12"
                                 To="0"
                                 Duration="0:0:0.8"
                                 BeginTime="0:0:0.2"
                                 EasingFunction="{StaticResource CubicEaseOut}" />
            </Storyboard>

            <Storyboard x:Key="LoadingAreaRevealAnimation">
                <DoubleAnimation Storyboard.TargetName="loadingPanel"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.5"
                                 EasingFunction="{StaticResource QuarticEaseOut}" />
                <DoubleAnimation Storyboard.TargetName="loadingPanel"
                                 Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                                 From="8"
                                 To="0"
                                 Duration="0:0:0.5"
                                 EasingFunction="{StaticResource CubicEaseOut}" />
            </Storyboard>

            <Storyboard x:Key="LoadingTextAnimation"
                        RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="loadingText"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.55"
                                 To="1"
                                 Duration="0:0:1.2"
                                 AutoReverse="True"
                                 EasingFunction="{StaticResource SineEaseInOut}" />
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <viewmodel:SplashViewModel />
    </Window.DataContext>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource RibbonBackgroundAnimation}" />
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="6"
            BorderBrush="#44000000"
            BorderThickness="1"
            Background="#FF38485A"
            ClipToBounds="True">
        <Grid>
            <!-- Base gradient -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#FF38485A"
                                      Offset="0" />
                        <GradientStop Color="#FF415366"
                                      Offset="0.55" />
                        <GradientStop Color="#FF344456"
                                      Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 3D ribbon layers (oversized paths clipped at window border) -->
            <Canvas Width="620"
                    Height="340"
                    IsHitTestVisible="False">
                    <Path x:Name="ribbonBack"
                          Data="M -60,400 C 100,250 250,320 380,200 C 470,120 545,165 680,70 L 680,400 L -60,400 Z"
                          Opacity="0.95">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,1"
                                                 EndPoint="1,0">
                                <GradientStop Color="#FF2A3545"
                                              Offset="0" />
                                <GradientStop Color="#FF354555"
                                              Offset="0.55" />
                                <GradientStop Color="#FF2E3D4E"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                        <Path.Effect>
                            <DropShadowEffect Color="#66000000"
                                              Direction="315"
                                              ShadowDepth="4"
                                              BlurRadius="12"
                                              Opacity="0.35" />
                        </Path.Effect>
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="ribbonBackTransform" />
                        </Path.RenderTransform>
                    </Path>

                    <Path x:Name="ribbonMid"
                          Data="M -60,400 C 70,285 200,325 330,240 C 440,165 510,200 680,115 L 680,400 L -60,400 Z"
                          Opacity="0.92">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0.1,1"
                                                 EndPoint="0.9,0">
                                <GradientStop Color="#FF3A5068"
                                              Offset="0" />
                                <GradientStop Color="#FF4A6888"
                                              Offset="0.45" />
                                <GradientStop Color="#FF3D5872"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                        <Path.Effect>
                            <DropShadowEffect Color="#88000000"
                                              Direction="300"
                                              ShadowDepth="5"
                                              BlurRadius="14"
                                              Opacity="0.28" />
                        </Path.Effect>
                        <Path.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="ribbonMidTransform" />
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>

                    <Path x:Name="ribbonFront"
                          Data="M -60,400 C 125,245 275,305 420,170 C 510,85 565,120 680,35 L 680,400 L -60,400 Z"
                          Opacity="0.90">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0.2"
                                                 EndPoint="1,0.8">
                                <GradientStop x:Name="ribbonLightStop1"
                                              Color="{StaticResource SsmsLightBlue}"
                                              Offset="0.1" />
                                <GradientStop x:Name="ribbonLightStop2"
                                              Color="{StaticResource SsmsWaveBlue}"
                                              Offset="0.55" />
                                <GradientStop Color="{StaticResource SsmsRoyalBlue}"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                        <Path.Effect>
                            <DropShadowEffect Color="#55000000"
                                              Direction="270"
                                              ShadowDepth="4"
                                              BlurRadius="12"
                                              Opacity="0.22" />
                        </Path.Effect>
                        <Path.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="ribbonFrontTransform"
                                                 CenterX="310"
                                                 CenterY="170"
                                                 Angle="0" />
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>

                    <Path x:Name="ribbonHighlight"
                          Data="M -60,400 L -60,310 C 100,250 220,200 350,120 C 455,55 515,80 680,20 L 680,205 C 510,240 320,275 -60,320 L -60,400 Z"
                          Opacity="0.48">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="#7738BDF8"
                                              Offset="0" />
                                <GradientStop Color="#0038BDF8"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="ribbonHighlightTransform" />
                        </Path.RenderTransform>
                    </Path>
            </Canvas>

            <!-- Close button -->
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,10,0"
                    Width="28"
                    Height="28"
                    Background="{DynamicResource TransparentBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Close"
                    Click="CloseButton_Click"
                    Panel.ZIndex="50">
                <TextBlock Text="&#x2715;"
                           FontSize="14"
                           Foreground="{StaticResource SsmsWhiteBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.85" />
            </Button>

            <!-- Center title -->
            <StackPanel x:Name="titleBlock"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,-18,0,0"
                        Opacity="0"
                        d:Opacity="1"
                        Panel.ZIndex="20">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>
                <TextBlock x:Name="titleText"
                           Text="Stats"
                           FontFamily="Segoe UI"
                           FontSize="54"
                           
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SsmsWhiteBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="yearText"
                           Text="2027"
                           FontFamily="Segoe UI"
                           FontSize="28"
                           FontWeight="Light"
                           Foreground="{StaticResource SsmsYearAccentBrush}"
                           HorizontalAlignment="Right"
                           Margin="-10,-20,0,0" />
            </StackPanel>

            <!-- Bottom-left branding + logo -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="20,0,0,44"
                        Panel.ZIndex="30">
                <Grid Width="34"
                      Height="34"
                      Margin="0,0,10,0">
                    <Image x:Name="logoGlow"
                           Source="/Images/stats_2025_Q512.png"
                           Width="34"
                           Height="34"
                           Opacity="0"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </Image.RenderTransform>
                        <Image.Effect>
                            <BlurEffect Radius="10" />
                        </Image.Effect>
                    </Image>
                    <Image x:Name="logo"
                           Source="/Images/stats_2025_Q512.png"
                           Width="24"
                           Height="24"
                           Opacity="0"
                           d:Opacity="1"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
                <TextBlock x:Name="brandText"
                           Text="AmL"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SsmsWhiteBrush}"
                           VerticalAlignment="Center"
                           Opacity="0"
                           d:Opacity="1">
                    <TextBlock.RenderTransform>
                        <TranslateTransform />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>

            <!-- Bottom-right version -->
            <TextBlock x:Name="versionNumber"
                       Text="{Binding SoftwareVersion}"
                       FontFamily="Segoe UI"
                       FontSize="32"
                       FontWeight="Light"
                       Foreground="{StaticResource SsmsWhiteBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,20,38"
                       Opacity="0"
                       Panel.ZIndex="30"
                       Cursor="Hand">
                <TextBlock.RenderTransform>
                    <TranslateTransform />
                </TextBlock.RenderTransform>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding ResetWindowPositionCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBlock>

            <!-- Loading area -->
            <StackPanel x:Name="loadingPanel"
                        VerticalAlignment="Bottom"
                        Margin="20,0,20,14"
                        Opacity="0"
                        Panel.ZIndex="40">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>
                <TextBlock x:Name="loadingText"
                           Text="{Binding LoadingText}"
                           d:Text="Checking server connection.."
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="{StaticResource SsmsMutedWhiteBrush}"
                           Margin="0,0,0,6" />
                <Grid x:Name="progressTrack"
                      Height="2">
                    <Border Background="#33FFFFFF"
                            CornerRadius="1" />
                    <ProgressBar Value="{Binding LoadingProgress}"
                                 Maximum="100"
                                 Height="2"
                                 Background="{DynamicResource TransparentBrush}"
                                 Foreground="{StaticResource SsmsWhiteBrush}"
                                 BorderThickness="0"
                                 Opacity="0.85">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border x:Name="PART_Track"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="1" />
                                    <Border x:Name="PART_Indicator"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="1"
                                            HorizontalAlignment="Left" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Grid>
            </StackPanel>

            <TextBlock Text="Window position got reset to default position"
                       FontFamily="Segoe UI"
                       FontSize="9"
                       Foreground="{StaticResource SsmsHighlightBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,36,0,0"
                       Visibility="{Binding WindowPosResetText}"
                       Panel.ZIndex="60" />
        </Grid>
    </Border>
</Window>
