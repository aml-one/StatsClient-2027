<Window x:Class="StatsClient.MVVM.View.OrderDeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete order — step 3 of 3"
        Height="280"
        Width="460"
        MinHeight="260"
        MinWidth="420"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{DynamicResource TransparentBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="0"
                      CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="OrderDeleteDangerButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#C0392B" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#962D22" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Padding"
                    Value="14,8" />
            <Setter Property="MinWidth"
                    Value="110" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#E74C3C" />
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrderDeleteSecondaryButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource ImmersiveGlassBackground}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource ImmersiveTextPrimary}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ImmersiveGlassBorder}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Padding"
                    Value="14,8" />
            <Setter Property="MinWidth"
                    Value="110" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource ImmersiveGlassBorder}"
            Background="{DynamicResource ClassicWindowBackgroundBrush}"
            ClipToBounds="True">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ImmersiveGlassBackground}"
                    BorderBrush="{DynamicResource ImmersiveGlassBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0"
                    Padding="10,8"
                    Margin="-14,-14,-14,10"
                    PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Delete order — step 3 of 3"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ImmersiveTextPrimary}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CloseButton"
                               Text="╳"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Cursor="Hand"
                               Foreground="{DynamicResource ImmersiveTextMuted}"
                               ToolTip="Cancel"
                               PreviewMouseLeftButtonDown="CloseButton_PreviewMouseLeftButtonDown" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ImmersiveTextPrimary}"
                       FontSize="13"
                       Margin="0,0,0,6">
                <Run Text="Type the order ID exactly to confirm permanent deletion:" />
                <LineBreak />
                <Run x:Name="ExpectedOrderIdRun"
                     FontWeight="Bold"
                     Foreground="IndianRed" />
            </TextBlock>

            <TextBox x:Name="ConfirmTextBox"
                     Grid.Row="2"
                     Height="34"
                     Margin="0,6,0,12"
                     FontSize="13"
                     Padding="8,6"
                     Background="{DynamicResource ImmersiveGlassBackground}"
                     Foreground="{DynamicResource ImmersiveTextPrimary}"
                     BorderBrush="{DynamicResource ImmersiveGlassBorder}"
                     TextChanged="ConfirmTextBox_TextChanged" />

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource OrderDeleteSecondaryButton}"
                        Margin="0,0,8,0"
                        Click="Cancel_Click" />
                <Button x:Name="DeleteButton"
                        Content="Delete permanently"
                        Style="{StaticResource OrderDeleteDangerButton}"
                        IsEnabled="False"
                        Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
